# The classic 10-car, 5-option, 6-class instance
# (Dincbas, Simonis, Van Hentenryck 1988)

set CLASSES := 1 2 3 4 5 6;
set OPTIONS := 1 2 3 4 5;

param demand := 1 1  2 1  3 2  4 2  5 2  6 2;

param p := 1 1  2 2  3 1  4 2  5 1;
param q := 1 2  2 3  3 3  4 5  5 5;

param req:  1 2 3 4 5 :=
         1  1 0 0 1 0
         2  0 0 0 1 0
         3  0 1 0 0 1
         4  0 1 0 0 0
         5  1 0 1 0 0
         6  1 1 0 0 0;
