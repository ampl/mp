# Fisher & Thompson 6x6 job-shop instance (ft06), optimum makespan 55
# mach: machine (1-based) of each operation; dur: its duration

set JOBS := 1 2 3 4 5 6;
param nops := 6;

param mach:  1 2 3 4 5 6 :=
         1   3 1 2 4 6 5
         2   2 3 5 6 1 4
         3   3 4 6 1 2 5
         4   2 1 3 4 5 6
         5   3 2 5 6 1 4
         6   2 4 6 1 5 3;

param dur:   1 2 3 4 5 6 :=
         1   1 3 6 7 3 6
         2   8 5 10 10 10 4
         3   5 4 8 9 1 7
         4   5 5 5 3 8 9
         5   9 3 5 4 3 1
         6   3 3 9 10 4 1;
