###############################################################
##### defvar_nl_01.mod
## Test MP2nL's DV output
###############################################################

var x {1..3} >=-2 <=5;

var dv1 = sin(x[1] + x[2]);
var dv2 = exp(x[2] - x[3]);
var dv3 = (x[3] - x[1])^2;

minimize OBJ: dv1 + dv3 + 1/dv3;

s.t. C1: dv1 >= dv2;

s.t. C2: dv2 >= x[1]+x[2]+x[3];
