###snapshot-version: 0.1.6
###model-start
param B integer > 0;
set BOATS = 1 .. B;
set HOSTS within BOATS;
set VISITORS = BOATS diff HOSTS;
param capacity{BOATS}  integer >= 0;
param crew{BOATS}  integer > 0;
param guest_cap{i in BOATS}  = capacity[i] less crew[i];
param T integer > 0;
set TIMES = 1 .. T;
set MEET = {j in VISITORS, jj in VISITORS: j < jj};
var H{VISITORS, TIMES}  integer >= 1
     <= B;
subject to VisitHosts{j in VISITORS, jj in VISITORS, t in TIMES} : H[j,t]
   != jj;
subject to VisitOnce{j in VISITORS} : alldiff({t in TIMES} (H[j,t]));
subject to Cap{i in HOSTS, t in TIMES} : sum{j in VISITORS} ( if H[j,t] == i
   then crew[j]) <= guest_cap[i];
subject to MeetDefn{(j,jj) in MEET} : atmost 1 ({t in TIMES} (H[j,t] == H[jj,t
  ]));
###model-end

###options-start
reset options;
environ Initial;
###options-end

###current-problem/environment-start
problem Initial;
environ Initial;
###current-problem/environment-end

