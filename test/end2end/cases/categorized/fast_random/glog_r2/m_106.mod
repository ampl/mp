var x{1..5} integer >= 0 <= 2;
minimize o: (1)*x[1] + (3)*x[2] + (3)*x[3] + (-5)*x[4] + (-2)*x[5];
s.t. c1: (x[3] <= 0) <==> (x[5] + x[4] == 0);
s.t. c2: atleast 2 {i in 1..5} (x[i] >= 0);
s.t. c3: (x[2] > 0) ==> (x[2] != 2) else (x[2] < 2);
s.t. c4: ((x[4] <= 2) ==> (x[2] == 0)) and ((x[2] == 0) ==> (x[4] >= 2));
