var x{1..6} integer >= 0 <= 2;
maximize o: (-2)*x[1] + (-3)*x[2] + (0)*x[3] + (3)*x[4] + (-5)*x[5] + (1)*x[6];
s.t. c1: (x[2] == 0) and (x[4] != 2) ==> (x[4] >= 0);
s.t. c2: (x[5] <= 2) or (x[6] < 1) or (x[1] == 1);
s.t. c3: (x[1] <= 0) or (x[1] == 0) or (x[4] <= 1);
s.t. c4: alldiff(x[4], x[5], x[2]);
