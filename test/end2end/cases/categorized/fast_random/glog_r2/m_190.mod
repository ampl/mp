var x{1..4} integer >= 0 <= 2;
maximize o: (0)*x[1] + (-4)*x[2] + (-4)*x[3] + (4)*x[4];
s.t. c1: not ((x[1] <= 1) and (x[2] <= 2));
s.t. c2: ((x[1] == 1) ==> (x[3] != 2)) and ((x[3] != 2) ==> (x[3] >= 1));
s.t. c3: (x[3] <= 2) or (x[3] > 2) or (x[2] < 0);
s.t. c4: numberof 1 in (x[1], x[2], x[3], x[4]) >= 3;
