var x{1..4} integer >= 0 <= 3;

minimize o: -4*x[1] - 5*x[2] - 4*x[3] - x[4];

s.t. c1: (x[2] > 0) ==> (x[4] > 3) else (x[4] > 3);
s.t. c2: (x[3] <= 0) and (x[4] == 3) ==> (x[4] >= 0);
s.t. c3: (x[2] >= 0) ==> (x[4] != 2) else (x[3] <= 3);
s.t. c4: ((x[1] >= 0) ==> (x[3] < 0)) and ((x[3] < 0) ==> (x[4] >= 0));
