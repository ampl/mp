var x{1..6} integer >= -2 <= 0;
minimize o: (3)*x[1] + (3)*x[2] + (4)*x[3] + (4)*x[4] + (6)*x[5] + (5)*x[6];
s.t. c1: not ((x[1] != -1) and (x[3] > -2));
s.t. c2: max(x[4], x[3]) - min(x[2], x[4]) == -2;
s.t. c3: (x[5] >= -2) or (x[4] != 0) or (x[1] > 0);
s.t. c4: not ((x[2] < -2) and (x[2] == -2));
