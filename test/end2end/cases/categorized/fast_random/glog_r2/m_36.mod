var x{1..6} integer >= 0 <= 4;
maximize o: (-4)*x[1] + (2)*x[2] + (3)*x[3] + (-5)*x[4] + (-5)*x[5] + (-4)*x[6];
s.t. c1: (x[6] != 0) <==> (x[1] + x[6] > 3);
s.t. c2: (x[1] != 0) and (x[2] > 4) ==> (x[1] >= 0);
s.t. c3: (x[1] < 3) and (x[2] != 3) ==> (x[2] >= 3);
s.t. c4: ((x[2] >= 0) ==> (x[3] <= 1)) and ((x[3] <= 1) ==> (x[1] >= 0));
