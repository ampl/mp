var x{1..6} integer >= -2 <= 1;

minimize o: 0*x[1] - 3*x[2] + 2*x[3] + 3*x[4] + 4*x[5] + 2*x[6];

s.t. c1: ((x[4] <= 0) ==> (x[5] == -2)) and ((x[5] == -2) ==> (x[4] >= 0));
s.t. c2: max(x[3], x[6]) - min(x[2], x[5]) == 0;
s.t. c3: (x[4] != 1) <==> (x[6] + x[4] >= -2);
s.t. c4: (x[6] != 1) or (x[6] == -1) or (x[2] == 0);
