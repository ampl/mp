var x{1..5} integer >= 0 <= 4;
minimize o: (0)*x[1] + (4)*x[2] + (-1)*x[3] + (-3)*x[4] + (5)*x[5];
s.t. c1: ((x[3] > 0) ==> (x[5] <= 2)) and ((x[5] <= 2) ==> (x[5] >= 0));
s.t. c2: (x[5] >= 3) <==> (x[2] + x[5] >= 0);
s.t. c3: ((x[3] > 0) ==> (x[5] <= 2)) and ((x[5] <= 2) ==> (x[5] >= 0));
s.t. c4: (x[5] >= 3) <==> (x[2] + x[5] >= 0);
