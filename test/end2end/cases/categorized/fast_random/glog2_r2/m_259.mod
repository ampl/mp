var x{1..6} integer >= 0 <= 2;
minimize o: (5)*x[1] + (3)*x[2] + (-3)*x[3] + (-1)*x[4] + (6)*x[5] + (1)*x[6];
s.t. c1: (x[4] >= 2) or (x[2] < 2) or (x[1] != 2);
s.t. c2: max(x[3], x[6]) - min(x[2], x[2]) <= 0;
s.t. c3: (x[4] >= 2) or (x[2] < 2) or (x[1] != 2);
s.t. c4: max(x[3], x[6]) - min(x[2], x[2]) <= 0;
