var x{1..4} integer >= -2 <= 2;
maximize o: (-2)*x[1] + (4)*x[2] + (-3)*x[3] + (-2)*x[4];
s.t. c1: (x[2] > 1) and (x[3] > 1) ==> (x[2] >= 1);
s.t. c2: (x[3] >= 1) ==> (x[2] >= 0);
s.t. c3: (x[4] == 0) and (x[3] > 2) ==> (x[2] >= 0);
s.t. c4: ((x[4] == -2) ==> (x[2] <= -2)) and ((x[2] <= -2) ==> (x[2] >= -2));
s.t. c5: alldiff(x[4], x[1], x[3], x[2]);
