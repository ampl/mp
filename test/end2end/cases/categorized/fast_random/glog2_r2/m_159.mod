var x{1..4} integer >= 0 <= 2;
maximize o: (-2)*x[1] + (-2)*x[2] + (1)*x[3] + (1)*x[4];
s.t. c1: (x[2] >= 2) <==> (x[3] + x[2] > 0);
s.t. c2: exists {i in 1..4} x[i] == 1;
s.t. c3: (x[4] > 1) ==> (x[2] < 0) else (x[3] == 0);
s.t. c4: (x[2] >= 2) <==> (x[3] + x[2] > 0);
s.t. c5: (x[4] > 1) ==> (x[2] < 0) else (x[3] == 0);
