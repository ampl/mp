var x{1..4} integer >= 0 <= 3;

minimize o: 0*x[1] - 3*x[2] + 6*x[3] + 3*x[4];

s.t. c1: (x[3] != 1) or (x[4] >= 0) or (x[4] > 0);
s.t. c2: (x[4] < 0) or (x[1] <= 2) or (x[1] >= 2);
s.t. c3: (x[2] != 3) or (x[4] == 3) or (x[4] != 3);
s.t. c4: (x[3] != 1) or (x[4] >= 0) or (x[4] > 0);
s.t. c5: (x[2] != 3) or (x[4] == 3) or (x[4] != 3);
