var x{1..4} integer >= -2 <= 0;

maximize o: 3*x[1] - 5*x[2] + 6*x[3] - 2*x[4];

s.t. c1: max(x[2], x[2]) - min(x[2], x[4]) == 0;
s.t. c2: ((x[2] == 0) ==> (x[4] < -1)) and ((x[4] < -1) ==> (x[1] >= 0));
s.t. c3: abs(x[1] - x[2]) >= 2;
s.t. c4: (x[3] != -2) <==> (x[2] + x[4] > -1);
s.t. c5: x[2] == 0;
s.t. c6: x[3] == 0;
