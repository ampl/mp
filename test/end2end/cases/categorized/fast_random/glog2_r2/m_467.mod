var x{1..5} integer >= -2 <= 1;

maximize o: 3000*x[1] + 17*x[2] + 2000*x[3] + 51*x[4] - 666*x[5];

s.t. c1: max(x[1], x[1]) - min(x[1], x[5]) == 1;
s.t. c2: ((x[3] > -2) ==> (x[4] <= 0)) and ((x[4] <= 0) ==> (x[1] >= -2));
s.t. c3: atmost 2 {i in 1..5} (x[i] >= -1);
s.t. c4: max(x[3], x[1]) - min(x[5], x[2]) != 1;
