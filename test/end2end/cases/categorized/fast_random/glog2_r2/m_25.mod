var x{1..3} integer >= 0 <= 3;

minimize o: 4*x[1] + 2*x[2] + 3*x[3];

s.t. c1: (x[3] == 0) ==> (x[1] == 2);
s.t. c2: (x[1] == 0) or (x[3] >= 3) or (x[3] == 2);
s.t. c3: (x[1] <= 2) ==> (x[3] >= 1);
s.t. c4: (x[3] > 0) ==> (x[2] <= 1);
s.t. c5: not ((x[1] == 0) and (x[2] >= 2));
s.t. c6: (x[3] == 1) or (x[1] <= 3) or (x[3] > 1);
s.t. c7: (x[1] == 0) <==> (x[3] + x[3] != 1);
