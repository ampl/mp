var x{1..5} integer >= -3 <= 2;

minimize o: -2*x[1] + 6*x[2] + 0*x[3] - 5*x[4] - 5*x[5];

s.t. c1: (if x[4] > 0 then x[2] else x[3]) == 2;
s.t. c2: ((x[1] != -1) ==> (x[3] < 1)) and ((x[3] < 1) ==> (x[2] >= -1));
s.t. c3: exists {i in 1..5} x[i] == 1;
s.t. c4: ((x[1] != 0) ==> (x[1] <= 2)) and ((x[1] <= 2) ==> (x[1] >= 0));
