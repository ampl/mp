var x{1..6} integer >= 0 <= 1;
maximize o: (4)*x[1] + (-5)*x[2] + (-3)*x[3] + (-1)*x[4] + (-2)*x[5] + (-3)*x[6];
s.t. c1: max(x[4], x[6]) - min(x[4], x[4]) >= 1;
s.t. c2: (x[2] != 1) ==> (x[1] <= 0) else (x[2] <= 1);
s.t. c3: (x[6] > 0) or (x[1] <= 1) or (x[2] == 0);
s.t. c4: (x[6] >= 0) ==> (x[5] == 0);
