var x{1..5} integer >= 0 <= 4;
minimize o: (5)*x[1] + (-3)*x[2] + (-1)*x[3] + (6)*x[4] + (-4)*x[5];
s.t. c1: (x[1] != 2) ==> (x[5] != 2);
s.t. c2: (x[1] > 1) ==> (x[5] != 4);
s.t. c3: alldiff(x[4], x[3], x[5]);
s.t. c4: (x[1] < 4) ==> (x[4] >= 2);
s.t. c5: (x[1] != 2) ==> (x[5] != 2);
s.t. c6: (x[1] < 4) ==> (x[4] >= 2);
