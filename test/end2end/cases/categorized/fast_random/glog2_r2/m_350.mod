var x{1..6} integer >= -2 <= 2;
minimize o: (-2)*x[1] + (-3)*x[2] + (6)*x[3] + (-2)*x[4] + (3)*x[5] + (4)*x[6];
s.t. c1: ((x[3] == 0) ==> (x[4] < -1)) and ((x[4] < -1) ==> (x[3] >= 0));
s.t. c2: not ((x[1] == 2) and (x[1] < 0));
s.t. c3: ((x[2] <= 0) ==> (x[1] <= -2)) and ((x[1] <= -2) ==> (x[5] >= 0));
s.t. c4: not ((x[3] <= -1) and (x[1] > 2));
