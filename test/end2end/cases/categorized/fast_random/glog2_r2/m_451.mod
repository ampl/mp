var x{1..6} integer >= 0 <= 3;
minimize o: (2)*x[1] + (-5)*x[2] + (-2)*x[3] + (3)*x[4] + (4)*x[5] + (0)*x[6];
s.t. c1: (x[3] <= 3) <==> (x[4] + x[6] > 3);
s.t. c2: (x[4] != 4) or (x[6] == 3) or (x[1] > 0);
s.t. c3: (x[1] == 3) and (x[4] <= 3) ==> (x[1] >= 3);
s.t. c4: atleast 1 {i in 1..6} (x[i] >= -1);
