var x{1..4} integer >= 0 <= 4;
minimize o: (4)*x[1] + (-3)*x[2] + (-3)*x[3] + (2)*x[4];
s.t. c1: (x[4] >= 1) <==> (x[1] + x[3] == 0);
s.t. c2: ((x[3] > 2) ==> (x[4] < 0)) and ((x[4] < 0) ==> (x[4] >= 2));
s.t. c3: abs(x[3] - x[2]) == 2;
s.t. c4: ((x[3] == 3) ==> (x[4] <= 0)) and ((x[4] <= 0) ==> (x[3] >= 3));
s.t. c5: (x[1] < 3) or (x[4] >= 3) or (x[4] > 0);
s.t. c6: (x[1] <= 4) ==> (x[1] > 0) else (x[1] >= 2);
s.t. c7: not ((x[1] >= 3) and (x[1] < 3));
