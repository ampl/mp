var x{1..6} integer >= 0 <= 3;
minimize o: (5)*x[1] + (-4)*x[2] + (-2)*x[3] + (5)*x[4] + (-3)*x[5] + (-5)*x[6];
s.t. c1: ((x[6] < 3) ==> (x[6] > 1)) and ((x[6] > 1) ==> (x[6] >= 3));
s.t. c2: ((if x[1] == 3 then 1 else 0) + (if x[4] >= 3 then 1 else 0)) >= 1;
s.t. c3: (x[2] > 2) ==> (x[2] >= 2);
s.t. c4: ((x[6] < 3) ==> (x[6] > 1)) and ((x[6] > 1) ==> (x[6] >= 3));
s.t. c5: (x[2] > 2) ==> (x[2] >= 2);
