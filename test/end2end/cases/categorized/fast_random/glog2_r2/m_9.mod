var x{1..5} integer >= 0 <= 3;

minimize o: 2*x[1] + 4*x[2] - 5*x[3] + 0*x[4] - 2*x[5];

s.t. c1: (x[3] != 0) <==> (x[2] + x[1] != 1);
s.t. c2: (x[3] <= 1) and (x[3] < 3) ==> (x[4] >= 1);
s.t. c3: not ((x[2] < 3) and (x[1] < 1));
s.t. c4: (x[3] != 0) <==> (x[2] + x[1] != 1);
s.t. c5: not ((x[2] < 3) and (x[1] < 1));
