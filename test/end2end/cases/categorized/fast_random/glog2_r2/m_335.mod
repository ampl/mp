var x{1..6} integer >= 0 <= 2;
maximize o: (2)*x[1] + (0)*x[2] + (-3)*x[3] + (6)*x[4] + (-5)*x[5] + (4)*x[6];
s.t. c1: forall {i in 1..5} x[i] != x[i+1];
s.t. c2: ((x[6] > 0) ==> (x[4] <= 0)) and ((x[4] <= 0) ==> (x[4] >= 0));
s.t. c3: (x[2] >= 2) <==> (x[3] + x[1] > 0);
s.t. c4: abs(x[5] - x[6]) == 0;
s.t. c5: alldiff(x[2], x[3], x[4], x[6]);
