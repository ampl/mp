var x{1..3} integer >= -2 <= 0;

minimize o: -5*x[1] - 4*x[2] + 6*x[3];

s.t. c1: (x[3] <= -2) or (x[1] != 0) or (x[1] != -2);
s.t. c2: (x[3] != -2) ==> (x[3] < 0) else (x[2] == -1);
s.t. c3: (x[2] == -1) ==> (x[2] < -2);
s.t. c4: not ((x[2] < -1) and (x[2] != 0));
s.t. c5: (x[2] < -2) <==> (x[2] + x[1] >= 0);
s.t. c6: numberof -2 in (x[1], x[2], x[3]) < 2;
