var x{1..4} integer >= -2 <= 0;
minimize o: (5)*x[1] + (-1)*x[2] + (3)*x[3] + (4)*x[4];
s.t. c1: ((x[2] < 0) ==> (x[2] > -2)) and ((x[2] > -2) ==> (x[1] >= 0));
s.t. c2: not ((x[2] == 0) and (x[4] != -1));
s.t. c3: ((x[2] < 0) ==> (x[2] > -2)) and ((x[2] > -2) ==> (x[1] >= 0));
s.t. c4: not ((x[2] == 0) and (x[4] != -1));
