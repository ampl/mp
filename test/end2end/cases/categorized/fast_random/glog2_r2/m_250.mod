var x{1..6} integer >= 0 <= 3;
maximize o: (4)*x[1] + (3)*x[2] + (-4)*x[3] + (5)*x[4] + (-3)*x[5] + (-3)*x[6];
s.t. c1: (if x[3] == 1 then x[5] else x[1]) != 1;
s.t. c2: ((x[3] < 1) ==> (x[4] != 0)) and ((x[4] != 0) ==> (x[2] >= 1));
s.t. c3: (x[2] >= 0) ==> (x[4] == 2) else (x[6] <= 1);
s.t. c4: abs(x[3] - x[3]) != 1;
