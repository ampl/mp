var x{1..7} integer >= 0 <= 1;
maximize o: (5)*x[1] + (-4)*x[2] + (-4)*x[3] + (2)*x[4] + (6)*x[5] + (3)*x[6] + (-4)*x[7];
s.t. c1: ((x[3] < 1) ==> (x[6] <= 1)) and ((x[6] <= 1) ==> (x[5] >= 1));
s.t. c2: max(x[5], x[5]) - min(x[1], x[2]) < 1;
s.t. c3: (if x[7] >= 1 then x[6] else x[4]) != 1;
s.t. c4: not ((x[6] >= 1) and (x[7] > 1));
