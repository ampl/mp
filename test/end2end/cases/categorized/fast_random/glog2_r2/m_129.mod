var x{1..4} integer >= 0 <= 3;
minimize o: (-3)*x[1] + (-2)*x[2] + (-2)*x[3] + (4)*x[4];
s.t. c1: (x[3] < 3) or (x[4] == 1) or (x[2] >= 0);
s.t. c2: (x[2] > 1) ==> (x[1] >= 0) else (x[4] == 1);
s.t. c3: ((x[2] == 0) ==> (x[2] == 3)) and ((x[2] == 3) ==> (x[1] >= 0));
s.t. c4: (x[3] < 3) or (x[4] == 1) or (x[2] >= 0);
s.t. c5: ((x[2] == 0) ==> (x[2] == 3)) and ((x[2] == 3) ==> (x[1] >= 0));
