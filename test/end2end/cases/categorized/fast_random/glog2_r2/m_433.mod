var x{1..4} integer >= 0 <= 2;

minimize o: -x[1] + 6*x[2] - x[3] - x[4];

s.t. c1: max(x[3], x[2]) - min(x[2], x[1]) < 2;
s.t. c2: not ((x[4] > 1) and (x[3] >= 0));
s.t. c3: ((x[2] >= 0) ==> (x[2] == 0)) and ((x[2] == 0) ==> (x[2] >= 0));
s.t. c4: (x[3] > 0) <==> (x[2] + x[2] < 2);
s.t. c5: x[3] == 2;
s.t. c6: x[4] == 0;
