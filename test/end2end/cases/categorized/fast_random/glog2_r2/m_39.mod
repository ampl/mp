var x{1..4} integer >= -2 <= 1;
maximize o: (-5)*x[1] + (1)*x[2] + (-1)*x[3] + (5)*x[4];
s.t. c1: not ((x[2] != -2) and (x[3] > 0));
s.t. c2: (x[4] < 0) ==> (x[4] > -1);
s.t. c3: alldiff(x[4], x[3]);
s.t. c4: (x[2] == 1) ==> (x[2] != -1);
s.t. c5: not ((x[2] != -2) and (x[3] > 0));
s.t. c6: (x[2] == 1) ==> (x[2] != -1);
