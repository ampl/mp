var x{1..3} integer >= -3 <= 2;

maximize o: 5*x[1] - 4*x[2] - 2*x[3];

s.t. c1: (x[3] == -1) and (x[2] != 2) ==> (x[3] >= -1);
s.t. c2: ((x[3] < 0) ==> (x[1] > -1)) and ((x[1] > -1) ==> (x[3] >= 0));
s.t. c3: (if x[3] != -1 then x[2] else x[3]) > -3;
s.t. c4: (x[2] == 0) or (x[3] != -2) or (x[3] < 0);
