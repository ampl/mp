var x{1..6} integer >= -2 <= 0;
minimize o: (2)*x[1] + (-2)*x[2] + (-2)*x[3] + (2)*x[4] + (0)*x[5] + (-5)*x[6];
s.t. c1: not ((x[5] == 0) and (x[2] <= -1));
s.t. c2: (x[4] > -2) ==> (x[2] == -1) else (x[6] >= -1);
s.t. c3: ((x[4] >= -1) ==> (x[1] <= 0)) and ((x[1] <= 0) ==> (x[6] >= -1));
s.t. c4: not ((x[4] <= 0) and (x[2] == -2));
s.t. c5: (x[5] == 0) or (x[5] != -2) or (x[6] >= -2);
