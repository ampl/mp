var x{1..6} integer >= -2 <= 0;
maximize o: (-5)*x[1] + (3)*x[2] + (4)*x[3] + (-1)*x[4] + (-5)*x[5] + (-5)*x[6];
s.t. c1: (x[5] != -2) and (x[6] <= -2) ==> (x[5] >= -2);
s.t. c2: (x[2] < -2) <==> (x[2] + x[5] > -2);
s.t. c3: (if x[6] > -2 then x[1] else x[5]) < -2;
s.t. c4: (x[6] == -1) or (x[4] < -1) or (x[5] < -1);
