var x{1..5} integer >= 0 <= 3;

minimize o: 6*x[1] - 2*x[2] + 6*x[3] - 4*x[4] + 5*x[5];

s.t. c1: (x[5] != 1) or (x[2] >= 2) or (x[2] <= 0);
s.t. c2: (x[3] != 3) or (x[2] != 2) or (x[5] <= 1);
s.t. c3: (x[5] <= 1) ==> (x[5] == 1) else (x[5] == 2);
s.t. c4: ((x[5] <= 3) ==> (x[4] >= 1)) and ((x[4] >= 1) ==> (x[3] >= 3));
