var x{1..4} integer >= -2 <= 1;

maximize o: x[1] + 5*x[2] + 6*x[3] + 5*x[4];

s.t. c1: (x[4] == -2) and (x[2] >= -2) ==> (x[4] >= -2);
s.t. c2: (x[2] < 0) and (x[4] <= -1) ==> (x[1] >= 0);
s.t. c3: (x[4] == -2) and (x[2] >= -2) ==> (x[4] >= -2);
s.t. c4: (x[2] < 0) and (x[4] <= -1) ==> (x[1] >= 0);
