var x{1..6} integer >= -2 <= 0;
minimize o: (-3)*x[1] + (5)*x[2] + (-5)*x[3] + (-2)*x[4] + (-2)*x[5] + (6)*x[6];
s.t. c1: (x[3] > 0) and (x[3] >= 0) ==> (x[3] >= 0);
s.t. c2: (x[4] >= -1) and (x[4] > -2) ==> (x[1] >= -1);
s.t. c3: abs(x[1] - x[3]) >= 2;
s.t. c4: (x[3] == -2) or (x[3] > -2) or (x[2] == -1);
