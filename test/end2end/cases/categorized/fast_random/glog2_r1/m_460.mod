var x{1..6} integer >= 0 <= 3;
maximize o: (2)*x[1] + (-5)*x[2] + (-1)*x[3] + (6)*x[4] + (0)*x[5] + (2)*x[6];
s.t. c1: (x[2] <= 0) ==> (x[4] >= 2) else (x[2] <= 2);
s.t. c2: abs(x[6] - x[6]) <= 2;
s.t. c3: (if x[5] == 0 then x[4] else x[5]) >= 1;
s.t. c4: (x[4] >= 2) ==> (x[3] > 0) else (x[4] >= 3);
