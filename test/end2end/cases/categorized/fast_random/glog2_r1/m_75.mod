var x{1..6} integer >= 0 <= 4;

maximize o: -5*x[1] - 2*x[2] + 2*x[3] + 2*x[4] + x[5] - 3*x[6];

s.t. c1: ((x[3] == 0) ==> (x[5] != 4)) and ((x[5] != 4) ==> (x[2] >= 0));
s.t. c2: forall {i in 1..5} x[i] != x[i+1];
s.t. c3: (x[4] <= 4) and (x[1] >= 1) ==> (x[5] >= 4);
s.t. c4: atmost 1 {i in 1..6} (x[i] >= 1);
s.t. c5: (x[5] < 4) <==> (x[4] + x[5] < 4);
s.t. c6: (x[4] <= 0) ==> (x[1] == 1) else (x[5] >= 0);
s.t. c7: (x[2] > 2) ==> (x[4] > 2);
