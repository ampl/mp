var x{1..6} integer >= -2 <= 0;

minimize o: -x[1] + 2*x[2] + 2*x[3] - 5*x[4] + 0*x[5] + 4*x[6];

s.t. c1: (x[4] < 0) ==> (x[6] < -1) else (x[1] != 0);
s.t. c2: (x[2] <= -1) ==> (x[5] < -1) else (x[2] != 0);
s.t. c3: (x[4] < 0) ==> (x[6] < -1) else (x[1] != 0);
s.t. c4: (x[2] <= -1) ==> (x[5] < -1) else (x[2] != 0);
