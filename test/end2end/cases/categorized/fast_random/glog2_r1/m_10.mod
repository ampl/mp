var x{1..6} integer >= -2 <= 0;
minimize o: (3)*x[1] + (-5)*x[2] + (-1)*x[3] + (-2)*x[4] + (3)*x[5] + (1)*x[6];
s.t. c1: (x[4] > 0) <==> (x[1] + x[5] >= -2);
s.t. c2: not ((x[6] >= -2) and (x[3] <= -1));
s.t. c3: (if x[4] < -2 then x[2] else x[1]) == -2;
s.t. c4: not ((x[6] >= -2) and (x[5] >= 0));
