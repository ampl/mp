var x{1..6} integer >= 0 <= 2;

maximize o: -3*x[1] - 5*x[2] + 3*x[3] - x[4] - 3*x[5] - 3*x[6];

s.t. c1: (x[1] >= 0) ==> (x[2] < 1) else (x[4] <= 0);
s.t. c2: (x[3] > 0) ==> (x[2] > 0);
s.t. c3: not ((x[1] <= 1) and (x[3] != 0));
s.t. c4: (x[1] < 2) or (x[2] == 0) or (x[5] < 2);
s.t. c5: (x[1] < 0) ==> (x[3] <= 0) else (x[4] == 0);
