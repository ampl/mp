var x{1..6} integer >= 0 <= 2;
minimize o: (0)*x[1] + (2)*x[2] + (-5)*x[3] + (5)*x[4] + (2)*x[5] + (5)*x[6];
s.t. c1: ((x[4] == 1) ==> (x[4] <= 0)) and ((x[4] <= 0) ==> (x[2] >= 1));
s.t. c2: (x[2] >= 2) and (x[5] == 0) ==> (x[1] >= 2);
s.t. c3: (x[3] > 2) ==> (x[2] != 0) else (x[1] < 1);
s.t. c4: x[1] == 2;
