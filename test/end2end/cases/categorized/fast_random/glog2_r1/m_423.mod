var x{1..4} integer >= -2 <= 0;
minimize o: (1)*x[1] + (-4)*x[2] + (0)*x[3] + (-2)*x[4];
s.t. c1: (x[2] > -1) ==> (x[2] == -2) else (x[2] >= -1);
s.t. c2: max(x[4], x[4]) - min(x[2], x[2]) >= -2;
s.t. c3: (x[2] >= -1) ==> (x[2] < -1);
s.t. c4: (x[3] > -2) or (x[2] >= 0) or (x[1] >= -1);
s.t. c5: x[2] == 0;
s.t. c6: x[4] == -2;
