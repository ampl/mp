var x{1..6} integer >= -2 <= 1;
minimize o: (3)*x[1] + (1)*x[2] + (4)*x[3] + (-1)*x[4] + (-3)*x[5] + (-4)*x[6];
s.t. c1: (x[2] > -1) ==> (x[3] > 1);
s.t. c2: alldiff(x[4], x[3], x[2], x[6]);
s.t. c3: (if x[4] <= -1 then x[2] else x[6]) != -2;
s.t. c4: ((x[4] < -1) ==> (x[6] == -2)) and ((x[6] == -2) ==> (x[4] >= -1));
s.t. c5: (x[2] > -1) ==> (x[3] > 1);
s.t. c6: ((x[4] < -1) ==> (x[6] == -2)) and ((x[6] == -2) ==> (x[4] >= -1));
