var x{1..5} integer >= -3 <= 2;

minimize o: -x[1] + 4*x[2] - 5*x[3] + 0*x[4] - 5*x[5];

s.t. c1: (x[5] == -2) ==> (x[4] == -2) else (x[2] <= 0);
s.t. c2: ((x[2] >= -1) ==> (x[3] == 0)) and ((x[3] == 0) ==> (x[5] >= -1));
s.t. c3: (x[4] <= 2) ==> (x[4] < -2) else (x[5] <= -1);
s.t. c4: ((x[4] <= 0) ==> (x[2] != -2)) and ((x[2] != -2) ==> (x[4] >= 0));
