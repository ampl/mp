var x{1..6} integer >= -2 <= 1;
maximize o: (0)*x[1] + (6)*x[2] + (-4)*x[3] + (-1)*x[4] + (-1)*x[5] + (2)*x[6];
s.t. c1: alldiff(x[4], x[6], x[1], x[5]);
s.t. c2: (if x[4] >= -2 then x[1] else x[6]) != 1;
s.t. c3: abs(x[2] - x[3]) < 3;
s.t. c4: ((x[1] != 0) ==> (x[3] != -2)) and ((x[3] != -2) ==> (x[5] >= 0));
