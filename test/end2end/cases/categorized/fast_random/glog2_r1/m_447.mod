var x{1..3} integer >= -2 <= 0;
maximize o: (-999)*x[1] + (-3000)*x[2] + (2000)*x[3];
s.t. c1: (x[1] != -2) ==> (x[3] != -2);
s.t. c2: (x[2] == -2) and (x[2] > 0) ==> (x[2] >= -2);
s.t. c3: ((x[3] == -1) ==> (x[1] != -1)) and ((x[1] != -1) ==> (x[1] >= -1));
s.t. c4: numberof 0 in (x[1], x[2], x[3]) < 0;
