var x{1..5} integer >= -2 <= 0;

maximize o: -3*x[1] + 0*x[2] + 0*x[3] - 5*x[4] - 2*x[5];

s.t. c1: (x[5] == -1) ==> (x[4] != -2);
s.t. c2: (if x[5] < -1 then x[4] else x[3]) <= -2;
s.t. c3: ((x[3] > -1) ==> (x[1] != -2)) and ((x[1] != -2) ==> (x[4] >= -1));
s.t. c4: x[5] == -2;
s.t. c5: x[4] == 0;
