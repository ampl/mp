var x{1..4} integer >= 0 <= 2;

minimize o: -3*x[1] + 5*x[2] + 5*x[3] + 2*x[4];

s.t. c1: (x[4] > 0) and (x[3] < 1) ==> (x[2] >= 0);
s.t. c2: abs(x[3] - x[3]) >= 0;
s.t. c3: (x[4] < 0) ==> (x[4] > 1) else (x[1] > 1);
s.t. c4: (x[4] > 0) and (x[3] < 1) ==> (x[2] >= 0);
s.t. c5: (x[4] < 0) ==> (x[4] > 1) else (x[1] > 1);
