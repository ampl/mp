var x{1..5} integer >= 0 <= 2;

maximize o: -2*x[1] - x[2] + 3*x[3] + 2*x[4] - 4*x[5];

s.t. c1: (x[2] == 1) <==> (x[1] + x[3] != 0);
s.t. c2: (x[4] > 0) ==> (x[5] != 2);
s.t. c3: (x[4] < 2) ==> (x[4] >= 2);
s.t. c4: not ((x[2] >= 1) and (x[4] <= 0));
s.t. c5: atleast 3 {i in 1..5} (x[i] >= 0);
s.t. c6: (x[1] < 1) <==> (x[4] + x[4] >= 2);
s.t. c7: atleast 3 {i in 1..5} (x[i] >= 1);
