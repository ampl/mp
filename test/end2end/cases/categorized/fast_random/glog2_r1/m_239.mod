var x{1..5} integer >= 0 <= 2;
minimize o: (1)*x[1] + (-3)*x[2] + (5)*x[3] + (4)*x[4] + (1)*x[5];
s.t. c1: ((x[4] == 1) ==> (x[1] < 1)) and ((x[1] < 1) ==> (x[5] >= 1));
s.t. c2: ((if x[1] > 2 then 1 else 0) + (if x[1] >= 2 then 1 else 0)) >= 1;
s.t. c3: ((x[4] > 2) ==> (x[3] > 1)) and ((x[3] > 1) ==> (x[5] >= 2));
s.t. c4: ((x[4] == 1) ==> (x[1] < 1)) and ((x[1] < 1) ==> (x[5] >= 1));
s.t. c5: ((x[4] > 2) ==> (x[3] > 1)) and ((x[3] > 1) ==> (x[5] >= 2));
