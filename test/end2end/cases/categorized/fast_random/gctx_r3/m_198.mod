var x{1..5} integer >= 0 <= 3;

minimize o: 0*x[1] + 3*x[2] + 4*x[3] + 5*x[4] + 0*x[5];

s.t. c1: (x[5] + x[3] < 3) or (min(x[3], x[1]) == 1);
s.t. c2: (x[5] + x[3] < 3) or (x[1] <= x[3]);
s.t. c3: (min(x[3], x[1]) == 1) ==> (x[1] <= x[3]) else (x[5] + x[3] < 3);
s.t. c4: (x[1] <= x[3]) <==> (x[5] + x[3] < 3);
