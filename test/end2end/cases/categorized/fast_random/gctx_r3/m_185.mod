var x{1..5} integer >= 0 <= 3;
maximize o: (4)*x[1] + (3)*x[2] + (0)*x[3] + (-3)*x[4] + (-2)*x[5] + (-4)*(if x[2] > 1 then 1 else 0);
s.t. c1: not (x[2] > 1);
s.t. c2: (x[2] > 1) <==> (max(x[1], x[3]) != 2);
s.t. c3: (x[2] > 1) <==> (max(x[1], x[3]) != 2);
s.t. c4: (max(x[1], x[3]) != 2) or (x[2] > 1);
