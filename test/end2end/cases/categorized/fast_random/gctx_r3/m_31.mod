var x{1..4} integer >= 0 <= 2;

maximize o:
   2*x[1] - 4*x[2] + 6*x[3] - 4*x[4] + 6*(if x[4] + x[2] < 2 then 1 else 0);

s.t. c1: (x[4] + x[2] < 2) and ((x[2] + x[2] <= 2) or not (x[2] + x[2] <= 2));
s.t. c2: (x[4] + x[2] < 2) ==> (x[2] + x[2] <= 2) else (x[4] + x[2] < 2);
s.t. c3: (x[4] + x[2] < 2) <==> (x[2] + x[2] <= 2);
s.t. c4: (x[2] + x[2] <= 2) or (x[4] + x[2] < 2);
