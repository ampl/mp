var x{1..5} integer >= 0 <= 2;
maximize o: (-2)*x[1] + (1)*x[2] + (-5)*x[3] + (6)*x[4] + (-2)*x[5] + (-3)*(if x[3] + x[3] >= 0 then 1 else 0);
s.t. c1: (x[1] + x[4] >= 1) <==> (x[3] + x[3] >= 0);
s.t. c2: not (x[5] > 2);
s.t. c3: not (x[1] + x[4] >= 1);
s.t. c4: (x[5] > 2) ==> ((x[1] + x[1] <= 0) or (x[3] + x[3] >= 0));
