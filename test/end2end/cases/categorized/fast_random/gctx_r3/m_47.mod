var x{1..3} integer >= 0 <= 2;

minimize o: -4*x[1] + 5*x[2] - 4*x[3];

s.t. c1: (x[1] + x[1] == 1) ==> ((abs(x[2] - x[3]) > 2) or (x[1] + x[1] == 1));
s.t. c2: (x[1] + x[1] == 1) <==> (abs(x[2] - x[3]) > 2);
s.t. c3: (x[2] < 0) ==> ((x[2] < 0) or (abs(x[2] - x[3]) > 2));
s.t. c4: not ((x[2] < 0) and (x[1] + x[1] == 1));
