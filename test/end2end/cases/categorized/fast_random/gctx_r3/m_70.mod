var x{1..5} integer >= 0 <= 2;
minimize o: (1)*x[1] + (2)*x[2] + (2)*x[3] + (-2)*x[4] + (1)*x[5];
s.t. c1: (max(x[1], x[5]) != 0) and ((max(x[1], x[5]) != 0) or not (max(x[1], x[5]) != 0));
s.t. c2: (max(x[1], x[5]) != 0) ==> (x[1] + x[3] != 2) else (max(x[1], x[5]) != 0);
s.t. c3: (max(x[1], x[5]) != 0) ==> (x[1] + x[3] != 2);
