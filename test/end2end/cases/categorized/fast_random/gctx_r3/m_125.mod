var x{1..3} integer >= -1 <= 2;
minimize o: (5)*x[1] + (3)*x[2] + (-2)*x[3] + (5)*(if x[1] > -1 then 1 else 0);
s.t. c1: not ((x[1] > -1) and (min(x[2], x[3]) != 0));
s.t. c2: (min(x[2], x[3]) != 0) <==> (x[1] == 1);
s.t. c3: (x[1] == 1) ==> ((x[1] == 1) or (min(x[2], x[3]) != 0));
s.t. c4: (min(x[2], x[3]) != 0) ==> (x[1] > -1);
