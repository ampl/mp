var x{1..5} integer >= 0 <= 2;
minimize o: (-1)*x[1] + (-3)*x[2] + (-2)*x[3] + (-4)*x[4] + (2)*x[5] + (2)*(if abs(x[2] - x[2]) != 2 then 1 else 0);
s.t. c1: (abs(x[2] - x[2]) != 2) ==> (abs(x[4] - x[5]) > 0) else (abs(x[2] - x[2]) != 2);
s.t. c2: (abs(x[4] - x[5]) > 0) <==> (abs(x[2] - x[2]) != 2);
s.t. c3: (abs(x[2] - x[2]) != 2) ==> (abs(x[4] - x[5]) > 0);
s.t. c4: (abs(x[2] - x[2]) != 2) <==> (abs(x[2] - x[2]) != 2);
