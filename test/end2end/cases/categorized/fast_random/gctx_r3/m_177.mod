var x{1..5} integer >= -1 <= 2;

maximize o:
   4*x[1] - 4*x[2] + 5*x[3] + 2*x[4] + 2*x[5]
   + 2*(if x[1] > x[2] then 1 else 0);

s.t. c1: (x[1] > x[2]) <==> (x[4] + x[3] > 1);
s.t. c2: (x[4] + x[3] > 1) ==> (x[1] > x[2]);
s.t. c3: (x[4] + x[3] > 1) ==> ((x[4] + x[3] > 1) or (x[1] > x[2]));
s.t. c4: (x[1] > x[2]) <==> (x[1] > x[2]);
