var x{1..5} integer >= -1 <= 1;
minimize o: (3)*x[1] + (1)*x[2] + (-5)*x[3] + (-5)*x[4] + (2)*x[5];
s.t. c1: (abs(x[5] - x[2]) <= 2) <==> (abs(x[5] - x[2]) <= 2);
s.t. c2: (abs(x[5] - x[2]) <= 2) ==> (min(x[5], x[2]) > 0) else (abs(x[5] - x[2]) <= 2);
s.t. c3: (abs(x[5] - x[2]) <= 2) ==> (abs(x[5] - x[2]) <= 2) else (min(x[5], x[2]) > 0);
