var x{1..4} integer >= 0 <= 3;
maximize o: (4)*x[1] + (-5)*x[2] + (2)*x[3] + (4)*x[4];
s.t. c1: (min(x[3], x[2]) > 2) ==> (max(x[3], x[1]) > 3) else (x[1] + x[2] <= 1);
s.t. c2: (x[4] < x[3]) ==> ((x[1] + x[2] <= 1) or (x[4] < x[3]));
s.t. c3: (x[4] < x[3]) ==> (min(x[3], x[2]) > 2) else (x[4] < x[3]);
