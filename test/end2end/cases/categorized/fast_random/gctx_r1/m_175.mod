var x{1..5} integer >= 0 <= 3;
maximize o: (1)*x[1] + (2)*x[2] + (-2)*x[3] + (-3)*x[4] + (5)*x[5] + (-2)*(if x[1] <= 3 then 1 else 0);
s.t. c1: (x[1] <= 3) ==> (x[1] <= 3) else (x[1] <= 3);
s.t. c2: (x[1] + x[2] == 0) <==> (x[1] <= 3);
s.t. c3: (x[1] + x[2] == 0) ==> ((x[1] <= 3) or (x[1] <= 3));
s.t. c4: (x[1] + x[2] == 0) or (x[1] + x[2] == 0);
