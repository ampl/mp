var x{1..4} integer >= 0 <= 2;
minimize o: (-4)*x[1] + (-1)*x[2] + (-2)*x[3] + (4)*x[4];
s.t. c1: (x[4] + x[1] != 0) <==> (max(x[3], x[1]) >= 2);
s.t. c2: (x[4] + x[1] != 0) ==> (x[4] + x[1] != 0) else (x[4] + x[1] != 0);
s.t. c3: (max(x[3], x[1]) >= 2) <==> (max(x[3], x[1]) >= 2);
s.t. c4: not ((x[4] + x[1] != 0) and (x[4] + x[1] != 0));
