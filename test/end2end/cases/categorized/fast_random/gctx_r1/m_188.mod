var x{1..3} integer >= 0 <= 3;

maximize o: -2*x[1] - 4*x[2] - 2*x[3];

s.t. c1: (x[2] <= 1) ==> ((x[2] <= 1) or (x[2] <= 1));
s.t. c2: (x[2] <= 1) ==> ((x[2] <= 1) or (x[2] + x[3] <= 2));
s.t. c3:
   (x[2] + x[3] <= 2) and ((min(x[3], x[2]) >= 0) or not (x[2] + x[3] <= 2));
s.t. c4: (x[2] <= 1) or (x[2] <= 1);
