var x{1..5} integer >= -1 <= 2;

minimize o:
   -2*x[1] + 2*x[2] + 3*x[3] + 4*x[4] + 0*x[5]
   + 4*(if x[5] + x[2] >= -1 then 1 else 0);

s.t. c1: (x[2] + x[5] > 0) <==> (x[5] + x[2] >= -1);
s.t. c2: (x[2] + x[5] > 0) <==> (x[5] + x[2] >= -1);
s.t. c3: (x[5] + x[2] >= -1) <==> (x[2] + x[5] > 0);
s.t. c4: (x[5] + x[2] >= -1) ==> (x[2] + x[5] > 0);
