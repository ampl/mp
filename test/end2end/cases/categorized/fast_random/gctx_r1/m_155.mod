var x{1..5} integer >= -1 <= 1;
minimize o: (4)*x[1] + (6)*x[2] + (5)*x[3] + (6)*x[4] + (-2)*x[5];
s.t. c1: (min(x[4], x[1]) < 0) or (min(x[3], x[4]) == 0);
s.t. c2: (min(x[4], x[1]) < 0) <==> (min(x[3], x[4]) == 0);
s.t. c3: (abs(x[5] - x[4]) < 0) ==> ((abs(x[5] - x[4]) < 0) or (min(x[4], x[1]) < 0));
