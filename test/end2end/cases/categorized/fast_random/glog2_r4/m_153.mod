var x{1..5} integer >= -2 <= 2;
maximize o: (-5)*x[1] + (-2)*x[2] + (3)*x[3] + (-4)*x[4] + (6)*x[5];
s.t. c1: max(x[2], x[1]) - min(x[3], x[4]) >= 1;
s.t. c2: atmost 3 {i in 1..5} (x[i] >= 2);
s.t. c3: (x[5] > -2) <==> (x[4] + x[3] != 2);
s.t. c4: (x[1] <= -1) <==> (x[3] + x[1] == -1);
s.t. c5: x[3] == -1;
