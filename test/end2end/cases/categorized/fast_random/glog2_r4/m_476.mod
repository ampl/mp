var x{1..4} integer >= 0 <= 3;
minimize o: (0)*x[1] + (0)*x[2] + (0)*x[3] + (0)*x[4];
s.t. c1: (x[4] >= 3) and (x[2] != 1) ==> (x[3] >= 3);
s.t. c2: (x[1] >= 1) ==> (x[3] >= 0) else (x[3] > 0);
s.t. c3: ((x[4] == 1) ==> (x[1] != 2)) and ((x[1] != 2) ==> (x[2] >= 1));
s.t. c4: (if x[1] < 2 then x[1] else x[3]) <= 1;
