var x{1..4} integer >= -2 <= 2;
minimize o: (0)*x[1] + (0)*x[2] + (0)*x[3] + (0)*x[4];
s.t. c1: alldiff(x[3], x[4], x[1], x[2]);
s.t. c2: (x[3] >= 1) ==> (x[3] > 1) else (x[4] != 2);
s.t. c3: not ((x[1] != -1) and (x[2] >= -1));
s.t. c4: ((x[1] < 2) ==> (x[1] == -2)) and ((x[1] == -2) ==> (x[3] >= 2));
