var x{1..6} integer >= -2 <= 1;

minimize o: 0*x[1] + 0*x[2] + 0*x[3] + 0*x[4] + 0*x[5] + 0*x[6];

s.t. c1: (x[6] >= 1) ==> (x[4] < 1);
s.t. c2: (x[5] < -1) and (x[4] >= -2) ==> (x[1] >= -1);
s.t. c3: ((x[5] < 0) ==> (x[6] >= -2)) and ((x[6] >= -2) ==> (x[3] >= 0));
s.t. c4: ((if x[1] > -2 then 1 else 0) + (if x[1] >= -2 then 1 else 0)) >= 1;
