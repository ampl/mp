var x{1..6} integer >= 0 <= 2;

maximize o: 3*x[1] - x[2] - 5*x[3] - x[4] + 3*x[5] - 4*x[6];

s.t. c1: ((x[4] > 0) ==> (x[2] != 0)) and ((x[2] != 0) ==> (x[4] >= 0));
s.t. c2: (x[1] > 2) and (x[1] < 1) ==> (x[3] >= 2);
s.t. c3: (x[1] > 0) or (x[2] >= 0) or (x[1] != 1);
s.t. c4: atmost 3 {i in 1..6} (x[i] >= 0);
s.t. c5: (x[4] > 2) or (x[2] >= 1) or (x[6] < 0);
s.t. c6: abs(x[1] - x[4]) != 0;
