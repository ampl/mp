var x{1..5} integer >= 0 <= 2;
minimize o: (6)*x[1] + (2)*x[2] + (-3)*x[3] + (-5)*x[4] + (4)*x[5];
s.t. c1: max(x[5], x[5]) - min(x[5], x[2]) == 2;
s.t. c2: (x[4] == 1) ==> (x[4] == 0) else (x[4] > 2);
s.t. c3: ((x[5] >= 0) ==> (x[1] <= 0)) and ((x[1] <= 0) ==> (x[3] >= 0));
s.t. c4: (x[4] <= 1) and (x[5] >= 0) ==> (x[3] >= 1);
s.t. c5: (if x[1] == 0 then x[2] else x[3]) < 0;
