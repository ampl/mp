var x{1..5} integer >= -2 <= 0;

maximize o: -2*x[1] + x[2] + 6*x[3] + x[4] - 5*x[5];

s.t. c1: (x[4] > -1) and (x[1] < -1) ==> (x[4] >= -1);
s.t. c2: ((x[4] >= 0) ==> (x[3] == -1)) and ((x[3] == -1) ==> (x[5] >= 0));
s.t. c3: (x[4] > -1) and (x[1] < -1) ==> (x[4] >= -1);
s.t. c4: ((x[4] >= 0) ==> (x[3] == -1)) and ((x[3] == -1) ==> (x[5] >= 0));
