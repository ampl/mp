var x{1..3} integer >= 0 <= 4;

minimize o: 5*x[1] - x[2] + x[3];

s.t. c1: ((x[1] > 1) ==> (x[2] < 0)) and ((x[2] < 0) ==> (x[2] >= 1));
s.t. c2: (x[1] < 3) and (x[3] != 2) ==> (x[1] >= 3);
s.t. c3: (x[2] <= 4) ==> (x[3] <= 3);
s.t. c4: (x[2] >= 4) ==> (x[1] == 3);
s.t. c5: (if x[2] <= 0 then x[2] else x[3]) != 1;
s.t. c6: (x[2] >= 2) and (x[3] == 0) ==> (x[2] >= 2);
s.t. c7: numberof 3 in (x[1], x[2], x[3]) == 3;
