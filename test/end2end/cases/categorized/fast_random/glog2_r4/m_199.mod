var x{1..6} integer >= 0 <= 2;

minimize o: 3*x[1] - x[2] - 4*x[3] - x[4] + 5*x[5] + 5*x[6];

s.t. c1: ((x[2] > 0) ==> (x[1] >= 0)) and ((x[1] >= 0) ==> (x[2] >= 0));
s.t. c2: (x[2] != 0) or (x[5] == 1) or (x[1] > 2);
s.t. c3: exists {i in 1..6} x[i] == 1;
s.t. c4: max(x[5], x[2]) - min(x[6], x[6]) <= 1;
s.t. c5: ((x[2] > 0) ==> (x[1] >= 0)) and ((x[1] >= 0) ==> (x[2] >= 0));
s.t. c6: max(x[5], x[2]) - min(x[6], x[6]) <= 1;
