var x{1..6} integer >= 0 <= 1;
maximize o: (-2)*x[1] + (6)*x[2] + (4)*x[3] + (2)*x[4] + (3)*x[5] + (1)*x[6];
s.t. c1: ((x[3] <= 0) ==> (x[3] > 0)) and ((x[3] > 0) ==> (x[4] >= 0));
s.t. c2: abs(x[4] - x[4]) != 0;
s.t. c3: alldiff(x[1], x[6], x[3], x[2]);
s.t. c4: ((x[4] != 1) ==> (x[4] == 0)) and ((x[4] == 0) ==> (x[3] >= 1));
