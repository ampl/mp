var x{1..6} integer >= 0 <= 3;
minimize o: (1)*x[1] + (6)*x[2] + (4)*x[3] + (-1)*x[4] + (3)*x[5] + (-3)*x[6];
s.t. c1: max(x[5], x[2]) - min(x[3], x[5]) >= 2;
s.t. c2: (x[1] == 0) <==> (x[3] + x[6] > 2);
s.t. c3: ((x[2] != 2) ==> (x[2] == 0)) and ((x[2] == 0) ==> (x[6] >= 2));
s.t. c4: not ((x[4] != 1) and (x[1] > 3));
s.t. c5: atmost 3 {i in 1..6} (x[i] >= 0);
