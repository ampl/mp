var x{1..4} integer >= 0 <= 2;
maximize o: (-2)*x[1] + (5)*x[2] + (-3)*x[3] + (6)*x[4];
s.t. c1: (x[3] >= 0) and (x[2] == 1) ==> (x[1] >= 0);
s.t. c2: not ((x[3] < 0) and (x[4] >= 1));
s.t. c3: alldiff(x[4], x[1], x[3]);
s.t. c4: (x[2] < 2) ==> (x[2] != 1);
s.t. c5: (x[3] >= 0) ==> (x[4] == 2) else (x[4] != 1);
s.t. c6: abs(x[3] - x[3]) > 0;
