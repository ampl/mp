var x{1..4} integer >= 0 <= 2;
maximize o: (6)*x[1] + (4)*x[2] + (-4)*x[3] + (6)*x[4];
s.t. c1: (x[3] != 2) ==> (x[1] != 1) else (x[3] == 0);
s.t. c2: (x[1] <= 2) and (x[4] == 2) ==> (x[3] >= 2);
s.t. c3: (x[3] != 2) ==> (x[1] != 1) else (x[3] == 0);
s.t. c4: (x[1] <= 2) and (x[4] == 2) ==> (x[3] >= 2);
