var x{1..5} integer >= 0 <= 4;
minimize o: (0)*x[1] + (0)*x[2] + (0)*x[3] + (0)*x[4] + (0)*x[5];
s.t. c1: max(x[5], x[1]) - min(x[5], x[1]) == 3;
s.t. c2: (x[2] == 4) ==> (x[4] == 2) else (x[1] >= 4);
s.t. c3: (x[5] >= 3) or (x[3] == 4) or (x[5] < 0);
s.t. c4: max(x[2], x[2]) - min(x[4], x[3]) == 2;
