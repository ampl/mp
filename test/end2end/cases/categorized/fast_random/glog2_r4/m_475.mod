var x{1..3} integer >= 0 <= 4;
minimize o: (2)*x[1] + (0)*x[2] + (-4)*x[3];
s.t. c1: ((x[3] == 1) ==> (x[3] == 4)) and ((x[3] == 4) ==> (x[2] >= 1));
s.t. c2: (x[1] > 3) and (x[2] != 1) ==> (x[3] >= 3);
s.t. c3: (if x[2] == 1 then x[1] else x[1]) >= 1;
s.t. c4: (x[1] < 2) <==> (x[3] + x[1] < 0);
s.t. c5: numberof 4 in (x[1], x[2], x[3]) < 0;
