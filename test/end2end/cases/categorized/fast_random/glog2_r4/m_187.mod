var x{1..6} integer >= -2 <= 1;

minimize o: 17*x[1] - 333*x[2] - 666*x[3] + 1000*x[4] - 999*x[5] + 1000*x[6];

s.t. c1: exists {i in 1..6} x[i] == 1;
s.t. c2: abs(x[3] - x[3]) <= 0;
s.t. c3: ((x[4] < -2) ==> (x[6] > 1)) and ((x[6] > 1) ==> (x[6] >= -2));
s.t. c4: (x[2] < -1) ==> (x[6] > 0) else (x[1] >= 1);
