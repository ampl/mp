var x{1..3} integer >= 0 <= 3;

minimize o: -2*x[1] + 2*x[2] + 6*x[3];

s.t. c1: abs(x[1] - x[2]) == 3;
s.t. c2: ((x[1] != 1) ==> (x[2] >= 0)) and ((x[2] >= 0) ==> (x[2] >= 1));
s.t. c3: alldiff(x[1], x[2], x[3]);
s.t. c4: (x[1] > 3) ==> (x[2] == 0) else (x[1] >= 1);
s.t. c5: abs(x[1] - x[2]) == 3;
s.t. c6: (x[1] > 3) ==> (x[2] == 0) else (x[1] >= 1);
