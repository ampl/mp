var x{1..6} integer >= -2 <= 0;
minimize o: (1)*x[1] + (-4)*x[2] + (-2)*x[3] + (6)*x[4] + (3)*x[5] + (2)*x[6];
s.t. c1: (x[5] != -1) ==> (x[2] > -2) else (x[5] < 0);
s.t. c2: exists {i in 1..6} x[i] == 0;
s.t. c3: (x[3] == -1) <==> (x[1] + x[6] != -1);
s.t. c4: alldiff(x[1], x[4], x[3]);
s.t. c5: (x[3] >= 0) or (x[1] >= -2) or (x[2] <= 0);
s.t. c6: max(x[2], x[1]) - min(x[6], x[2]) != -2;
s.t. c7: (x[5] != 0) or (x[6] == 0) or (x[6] < -1);
