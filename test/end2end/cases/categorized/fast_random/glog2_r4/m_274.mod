var x{1..5} integer >= -3 <= 2;
maximize o: (-2)*x[1] + (-4)*x[2] + (6)*x[3] + (4)*x[4] + (-4)*x[5];
s.t. c1: (x[3] < -1) <==> (x[4] + x[4] != -3);
s.t. c2: (x[2] == -2) and (x[3] > -1) ==> (x[1] >= -2);
s.t. c3: forall {i in 1..4} x[i] != x[i+1];
s.t. c4: (x[2] != -1) and (x[4] <= 0) ==> (x[1] >= -1);
