var x{1..7} integer >= 0 <= 1;
minimize o: (-5)*x[1] + (-2)*x[2] + (1)*x[3] + (0)*x[4] + (2)*x[5] + (6)*x[6] + (-5)*x[7];
s.t. c1: (x[1] < 0) or (x[4] <= 0) or (x[3] > 0);
s.t. c2: (x[7] < 0) and (x[3] >= 1) ==> (x[5] >= 0);
s.t. c3: max(x[4], x[1]) - min(x[7], x[3]) == 1;
s.t. c4: not ((x[6] != 1) and (x[7] == 1));
