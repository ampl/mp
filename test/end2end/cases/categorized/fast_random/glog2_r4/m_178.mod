var x{1..7} integer >= 0 <= 1;
minimize o: (-3)*x[1] + (1)*x[2] + (-4)*x[3] + (1)*x[4] + (0)*x[5] + (3)*x[6] + (6)*x[7];
s.t. c1: (x[7] <= 0) ==> (x[1] > 1);
s.t. c2: ((x[5] != 1) ==> (x[5] > 0)) and ((x[5] > 0) ==> (x[2] >= 1));
s.t. c3: (x[1] >= 0) ==> (x[1] != 1) else (x[7] <= 1);
s.t. c4: alldiff(x[7], x[6], x[3], x[2]);
