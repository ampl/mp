var x{1..5} integer >= 0 <= 2;
maximize o: (4)*x[1] + (5)*x[2] + (1)*x[3] + (0)*x[4] + (0)*x[5];
s.t. c1: (x[1] >= 1) <==> (x[4] + x[3] > 1);
s.t. c2: ((x[3] > 2) ==> (x[1] <= 1)) and ((x[1] <= 1) ==> (x[5] >= 2));
s.t. c3: ((if x[1] != 1 then 1 else 0) + (if x[2] >= 1 then 1 else 0)) >= 1;
s.t. c4: x[3] == 0;
s.t. c5: x[2] == 2;
