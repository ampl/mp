var x{1..6} integer >= 0 <= 3;
maximize o: (-2)*x[1] + (5)*x[2] + (-5)*x[3] + (-2)*x[4] + (4)*x[5] + (-4)*x[6];
s.t. c1: (x[3] >= 2) or (x[6] >= 2) or (x[3] < 2);
s.t. c2: (x[1] >= 2) ==> (x[4] == 0);
s.t. c3: alldiff(x[5], x[6], x[2], x[1]);
s.t. c4: (x[3] > 2) or (x[6] <= 3) or (x[1] < 0);
s.t. c5: (x[6] > 0) ==> (x[1] <= 1);
s.t. c6: not ((x[5] != 3) and (x[6] != 3));
