var x{1..5} integer >= 0 <= 2;
maximize o: (1)*x[1] + (3)*x[2] + (1)*x[3] + (3)*x[4] + (5)*x[5];
s.t. c1: (x[4] != 0) and (x[1] <= 1) ==> (x[5] >= 0);
s.t. c2: ((x[3] <= 0) ==> (x[2] < 1)) and ((x[2] < 1) ==> (x[4] >= 0));
s.t. c3: (x[3] > 1) and (x[1] < 2) ==> (x[3] >= 1);
s.t. c4: alldiff(x[4], x[3], x[5]);
