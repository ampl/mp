var x{1..6} integer >= 0 <= 2;
minimize o: (-3)*x[1] + (2)*x[2] + (-5)*x[3] + (-2)*x[4] + (-5)*x[5] + (-5)*x[6];
s.t. c1: ((x[5] >= 1) ==> (x[2] >= 0)) and ((x[2] >= 0) ==> (x[6] >= 1));
s.t. c2: forall {i in 1..5} x[i] != x[i+1];
s.t. c3: (x[1] != 0) ==> (x[5] >= 1) else (x[5] < 2);
s.t. c4: max(x[1], x[1]) - min(x[3], x[6]) == 0;
