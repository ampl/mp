var x{1..5} integer >= -1 <= 2;
maximize o: (-2)*x[1] + (-3)*x[2] + (-2)*x[3] + (3)*x[4] + (1)*x[5];
s.t. c1: (abs(x[3] - x[4]) >= 0) ==> (abs(x[3] - x[2]) > 3);
s.t. c2: (x[2] > 0) ==> (abs(x[3] - x[2]) > 3) else (abs(x[3] - x[2]) > 3);
s.t. c3: (x[2] > 0) ==> ((x[2] > 0) or (abs(x[3] - x[4]) >= 0));
