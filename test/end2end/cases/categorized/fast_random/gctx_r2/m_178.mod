var x{1..4} integer >= 0 <= 3;
maximize o: (-2)*x[1] + (3)*x[2] + (1)*x[3] + (6)*x[4];
s.t. c1: (abs(x[2] - x[2]) <= 3) ==> (min(x[3], x[2]) == 2) else (min(x[3], x[2]) == 2);
s.t. c2: (abs(x[2] - x[2]) <= 3) ==> (abs(x[2] - x[2]) <= 3) else (abs(x[2] - x[2]) <= 3);
s.t. c3: (min(x[3], x[2]) == 2) <==> (abs(x[2] - x[2]) <= 3);
s.t. c4: (min(x[3], x[2]) == 2) ==> (min(x[3], x[2]) == 2);
