var x{1..4} integer >= -1 <= 2;
minimize o: (1)*x[1] + (6)*x[2] + (3)*x[3] + (2)*x[4];
s.t. c1: (abs(x[1] - x[2]) == 1) ==> ((abs(x[1] - x[2]) == 1) or (abs(x[1] - x[2]) == 1));
s.t. c2: (max(x[3], x[2]) == -1) ==> ((abs(x[1] - x[2]) == 1) or (x[4] + x[3] < 0));
s.t. c3: (abs(x[1] - x[2]) == 1) ==> (max(x[3], x[2]) == -1) else (abs(x[1] - x[2]) == 1);
