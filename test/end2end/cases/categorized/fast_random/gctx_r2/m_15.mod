var x{1..5} integer >= 0 <= 3;
minimize o: (2)*x[1] + (-4)*x[2] + (-1)*x[3] + (4)*x[4] + (1)*x[5] + (-1)*(if x[1] + x[3] < 1 then 1 else 0);
s.t. c1: (x[4] + x[1] != 3) <==> (x[5] + x[2] == 0);
s.t. c2: (x[4] + x[1] != 3) <==> (x[1] + x[3] < 1);
s.t. c3: (x[4] + x[1] != 3) <==> (x[1] + x[3] < 1);
s.t. c4: (x[5] + x[2] == 0) and ((x[5] + x[2] == 0) or not (x[5] + x[2] == 0));
