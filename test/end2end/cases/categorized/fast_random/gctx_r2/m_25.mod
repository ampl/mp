var x{1..5} integer >= 0 <= 3;
minimize o: (5)*x[1] + (5)*x[2] + (4)*x[3] + (4)*x[4] + (-3)*x[5];
s.t. c1: (x[3] > x[4]) and ((x[5] < x[2]) or not (max(x[3], x[4]) <= 2));
s.t. c2: (x[5] < x[2]) ==> ((max(x[3], x[4]) <= 2) or (x[5] < x[2]));
s.t. c3: (x[5] < x[2]) ==> (x[3] > x[4]) else (x[5] < x[2]);
