var x{1..5} integer >= -2 <= 0;
minimize o: (3)*x[1] + (-1)*x[2] + (-4)*x[3] + (-2)*x[4] + (-5)*x[5];
s.t. c1: (x[5] != -2) <==> (x[3] + x[4] > -2);
s.t. c2: ((if x[5] < -2 then 1 else 0) + (if x[5] >= -2 then 1 else 0)) >= 1;
s.t. c3: atmost 2 {i in 1..5} (x[i] >= -1);
s.t. c4: ((x[1] <= -1) ==> (x[5] < 0)) and ((x[5] < 0) ==> (x[1] >= -1));
