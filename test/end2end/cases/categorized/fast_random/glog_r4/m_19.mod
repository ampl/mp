var x{1..6} integer >= -2 <= 2;

maximize o: 5*x[1] + 4*x[2] - 5*x[3] + 6*x[4] - 5*x[5] - 3*x[6];

s.t. c1: ((x[4] <= 2) ==> (x[3] >= 1)) and ((x[3] >= 1) ==> (x[6] >= 2));
s.t. c2: ((x[1] < -2) ==> (x[1] <= 2)) and ((x[1] <= 2) ==> (x[2] >= -2));
s.t. c3: (x[4] == 2) ==> (x[1] > 0) else (x[1] != -1);
s.t. c4: exists {i in 1..6} x[i] == 2;
