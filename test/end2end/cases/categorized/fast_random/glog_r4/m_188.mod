var x{1..5} integer >= 0 <= 4;
minimize o: (-5)*x[1] + (-2)*x[2] + (-3)*x[3] + (-5)*x[4] + (-2)*x[5];
s.t. c1: (x[1] > 2) or (x[4] > 2) or (x[4] != 3);
s.t. c2: ((x[2] <= 3) ==> (x[3] == 4)) and ((x[3] == 4) ==> (x[5] >= 3));
s.t. c3: (x[2] == 0) and (x[1] >= 3) ==> (x[2] >= 0);
s.t. c4: (x[1] != 0) <==> (x[4] + x[1] != 4);
