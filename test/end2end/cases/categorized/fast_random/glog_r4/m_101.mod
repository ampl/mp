var x{1..5} integer >= 0 <= 4;
minimize o: (4)*x[1] + (-1)*x[2] + (-4)*x[3] + (5)*x[4] + (-4)*x[5];
s.t. c1: ((x[4] == 0) ==> (x[3] != 1)) and ((x[3] != 1) ==> (x[2] >= 0));
s.t. c2: alldiff(x[1], x[5], x[2], x[3]);
s.t. c3: atmost 3 {i in 1..5} (x[i] >= 4);
s.t. c4: ((x[1] != 1) ==> (x[2] != 1)) and ((x[2] != 1) ==> (x[4] >= 1));
