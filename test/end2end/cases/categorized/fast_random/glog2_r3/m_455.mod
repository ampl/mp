var x{1..4} integer >= 0 <= 3;
minimize o: (5)*x[1] + (6)*x[2] + (0)*x[3] + (-1)*x[4];
s.t. c1: (x[2] < 3) ==> (x[1] <= 2) else (x[4] == 2);
s.t. c2: (x[3] >= 1) and (x[2] <= 0) ==> (x[4] >= 1);
s.t. c3: ((if x[4] <= 0 then 1 else 0) + (if x[4] >= 0 then 1 else 0)) >= 1;
s.t. c4: (x[3] <= 2) ==> (x[4] > 0) else (x[4] <= 0);
s.t. c5: (x[2] == 3) <==> (x[3] + x[4] >= 1);
