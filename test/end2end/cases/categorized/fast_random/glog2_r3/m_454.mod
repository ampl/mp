var x{1..4} integer >= -3 <= 2;

maximize o: x[1] - 2*x[2] + 5*x[3] + x[4];

s.t. c1: ((x[4] <= 0) ==> (x[4] <= 2)) and ((x[4] <= 2) ==> (x[3] >= 0));
s.t. c2: numberof 0 in (x[1], x[2], x[3], x[4]) > 0;
s.t. c3: max(x[3], x[1]) - min(x[1], x[3]) < 0;
s.t. c4: ((x[3] != -1) ==> (x[1] >= -3)) and ((x[1] >= -3) ==> (x[3] >= -1));
