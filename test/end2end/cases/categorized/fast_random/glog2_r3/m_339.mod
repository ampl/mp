var x{1..4} integer >= 0 <= 2;

maximize o: -3*x[1] + x[2] + 2*x[3] - 2*x[4];

s.t. c1: not ((x[2] >= 0) and (x[2] != 0));
s.t. c2: ((x[1] >= 2) ==> (x[1] < 0)) and ((x[1] < 0) ==> (x[3] >= 2));
s.t. c3: not ((x[2] >= 0) and (x[2] != 0));
s.t. c4: ((x[1] >= 2) ==> (x[1] < 0)) and ((x[1] < 0) ==> (x[3] >= 2));
