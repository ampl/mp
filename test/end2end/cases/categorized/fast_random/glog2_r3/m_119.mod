var x{1..5} integer >= 0 <= 2;
maximize o: (1)*x[1] + (-5)*x[2] + (6)*x[3] + (-4)*x[4] + (4)*x[5];
s.t. c1: (x[4] != 1) or (x[1] <= 0) or (x[5] < 0);
s.t. c2: (x[3] > 0) ==> (x[1] < 1);
s.t. c3: (if x[3] == 0 then x[3] else x[5]) < 1;
s.t. c4: (x[2] <= 0) ==> (x[1] > 1) else (x[5] > 2);
s.t. c5: (x[4] != 1) or (x[1] <= 0) or (x[5] < 0);
s.t. c6: (x[2] <= 0) ==> (x[1] > 1) else (x[5] > 2);
