var x{1..4} integer >= -2 <= 2;
maximize o: (0)*x[1] + (-1)*x[2] + (-4)*x[3] + (0)*x[4];
s.t. c1: (x[1] >= 2) <==> (x[3] + x[1] < 2);
s.t. c2: ((x[1] == -2) ==> (x[2] < -2)) and ((x[2] < -2) ==> (x[4] >= -2));
s.t. c3: abs(x[2] - x[3]) == 2;
s.t. c4: (x[1] >= 2) <==> (x[3] + x[1] < 2);
s.t. c5: abs(x[2] - x[3]) == 2;
