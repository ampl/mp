var x{1..4} integer >= -2 <= 1;

maximize o: -4*x[1] - 4*x[2] + 4*x[3] + 4*x[4];

s.t. c1: (x[1] != -2) and (x[3] <= -2) ==> (x[2] >= -2);
s.t. c2: (x[2] > 1) ==> (x[3] == -1) else (x[1] <= 0);
s.t. c3: atmost 1 {i in 1..4} (x[i] >= -1);
s.t. c4: max(x[3], x[1]) - min(x[2], x[2]) > -1;
s.t. c5: (x[4] < 0) <==> (x[3] + x[2] != -2);
s.t. c6: (x[1] != -2) or (x[4] < -2) or (x[1] > 0);
