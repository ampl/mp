var x{1..4} integer >= -2 <= 0;

maximize o: 6*x[1] - x[2] - x[3] + 4*x[4];

s.t. c1: (x[2] >= -1) <==> (x[2] + x[1] > -1);
s.t. c2: (x[1] < -2) or (x[4] == -1) or (x[3] == -2);
s.t. c3: forall {i in 1..3} x[i] != x[i+1];
s.t. c4: (x[2] >= -1) ==> (x[4] != -2);
s.t. c5: (x[2] <= -2) and (x[1] >= -1) ==> (x[2] >= -2);
