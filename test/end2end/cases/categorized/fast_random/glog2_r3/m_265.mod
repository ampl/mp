var x{1..5} integer >= 0 <= 2;
maximize o: (-4)*x[1] + (1)*x[2] + (-3)*x[3] + (4)*x[4] + (-2)*x[5];
s.t. c1: (x[1] <= 1) ==> (x[2] != 0) else (x[5] != 1);
s.t. c2: (x[1] != 0) ==> (x[3] >= 2) else (x[3] > 1);
s.t. c3: (x[1] < 2) ==> (x[2] > 2);
s.t. c4: (x[2] <= 0) ==> (x[4] >= 2) else (x[3] <= 0);
s.t. c5: (x[4] <= 2) ==> (x[4] != 0) else (x[1] != 2);
s.t. c6: atleast 1 {i in 1..5} (x[i] >= 2);
