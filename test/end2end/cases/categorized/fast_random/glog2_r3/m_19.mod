var x{1..6} integer >= -2 <= 0;
maximize o: (0)*x[1] + (-4)*x[2] + (5)*x[3] + (0)*x[4] + (0)*x[5] + (0)*x[6];
s.t. c1: (x[2] == -2) or (x[1] <= -1) or (x[4] == -2);
s.t. c2: (x[5] < -1) ==> (x[3] <= -1) else (x[5] >= -2);
s.t. c3: not ((x[5] > -1) and (x[1] == -2));
s.t. c4: (x[1] == 0) and (x[1] == -2) ==> (x[3] >= 0);
s.t. c5: (x[2] == -2) or (x[1] <= -1) or (x[4] == -2);
s.t. c6: (x[1] == 0) and (x[1] == -2) ==> (x[3] >= 0);
