var x{1..6} integer >= -2 <= 1;
maximize o: (0)*x[1] + (-5)*x[2] + (0)*x[3] + (-1)*x[4] + (4)*x[5] + (-2)*x[6];
s.t. c1: (x[3] != 0) <==> (x[6] + x[6] < 0);
s.t. c2: (x[4] != -1) or (x[4] < 0) or (x[6] < -2);
s.t. c3: (if x[5] >= -2 then x[5] else x[2]) > 0;
s.t. c4: (x[6] == 1) ==> (x[5] < 0) else (x[1] != 1);
