var x{1..6} integer >= -2 <= 2;
minimize o: (0)*x[1] + (2)*x[2] + (-3)*x[3] + (3)*x[4] + (-3)*x[5] + (5)*x[6];
s.t. c1: (x[2] != -2) or (x[1] <= 0) or (x[3] != -1);
s.t. c2: ((if x[4] < 1 then 1 else 0) + (if x[4] >= 1 then 1 else 0)) >= 1;
s.t. c3: (x[4] > 0) ==> (x[6] > 0) else (x[2] == 2);
s.t. c4: (x[3] == 2) or (x[3] != 2) or (x[1] >= -1);
s.t. c5: (x[2] != -2) or (x[1] <= 0) or (x[3] != -1);
s.t. c6: (x[3] == 2) or (x[3] != 2) or (x[1] >= -1);
