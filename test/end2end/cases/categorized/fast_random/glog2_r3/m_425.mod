var x{1..4} integer >= 0 <= 4;

minimize o: 3*x[1] - 3*x[2] + 3*x[3] - 2*x[4];

s.t. c1: (x[4] >= 3) ==> (x[3] != 0);
s.t. c2: ((x[4] < 4) ==> (x[2] != 0)) and ((x[2] != 0) ==> (x[4] >= 4));
s.t. c3: abs(x[3] - x[4]) != 3;
s.t. c4: (x[2] >= 1) and (x[2] >= 1) ==> (x[1] >= 1);
s.t. c5: numberof 3 in (x[1], x[2], x[3], x[4]) <= 3;
