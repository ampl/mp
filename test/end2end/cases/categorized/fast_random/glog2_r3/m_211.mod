var x{1..5} integer >= 0 <= 2;

minimize o: -x[1] - 4*x[2] + 6*x[3] - 3*x[4] + 0*x[5];

s.t. c1: ((x[4] >= 2) ==> (x[4] != 3)) and ((x[4] != 3) ==> (x[1] >= 2));
s.t. c2: ((x[3] <= 0) ==> (x[4] >= -1)) and ((x[4] >= -1) ==> (x[5] >= 0));
s.t. c3: (if x[1] > 3 then x[3] else x[4]) != -1;
s.t. c4: not ((x[4] >= 2) and (x[2] <= 3));
