var x{1..5} integer >= -2 <= 2;

maximize o: -3000*x[1] - 2000*x[2] - 999*x[3] + 51*x[4] + 1000*x[5];

s.t. c1: ((x[1] < 0) ==> (x[4] > -2)) and ((x[4] > -2) ==> (x[1] >= 0));
s.t. c2: alldiff(x[2], x[4], x[3]);
s.t. c3: (x[4] < -1) ==> (x[4] >= 2) else (x[2] == 1);
s.t. c4: (if x[2] < 0 then x[2] else x[2]) > -2;
