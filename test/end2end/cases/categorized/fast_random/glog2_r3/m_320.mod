var x{1..4} integer >= -2 <= 2;

maximize o: 0*x[1] - 5*x[2] + 0*x[3] - 2*x[4];

s.t. c1: (if x[4] < 1 then x[3] else x[4]) < 0;
s.t. c2: ((x[1] > 2) ==> (x[2] > 1)) and ((x[2] > 1) ==> (x[4] >= 2));
s.t. c3: ((x[4] > 2) ==> (x[2] >= 2)) and ((x[2] >= 2) ==> (x[4] >= 2));
s.t. c4: not ((x[3] >= 2) and (x[1] == -2));
