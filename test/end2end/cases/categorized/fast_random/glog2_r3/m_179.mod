var x{1..4} integer >= 0 <= 2;
minimize o: (1)*x[1] + (-3)*x[2] + (-3)*x[3] + (-2)*x[4];
s.t. c1: (x[3] >= 0) and (x[1] > 1) ==> (x[3] >= 0);
s.t. c2: (x[3] == 2) and (x[4] == 2) ==> (x[3] >= 2);
s.t. c3: abs(x[3] - x[3]) > 1;
s.t. c4: (x[3] >= 0) and (x[1] > 1) ==> (x[3] >= 0);
s.t. c5: abs(x[3] - x[3]) > 1;
