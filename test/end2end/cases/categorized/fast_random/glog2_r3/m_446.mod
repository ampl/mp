var x{1..4} integer >= -2 <= 1;
maximize o: (0)*x[1] + (0)*x[2] + (0)*x[3] + (0)*x[4];
s.t. c1: (x[4] != 0) ==> (x[2] >= 1);
s.t. c2: ((x[2] == -2) ==> (x[3] <= 0)) and ((x[3] <= 0) ==> (x[1] >= -2));
s.t. c3: ((x[2] > 0) ==> (x[3] < 1)) and ((x[3] < 1) ==> (x[4] >= 0));
s.t. c4: not ((x[4] != 1) and (x[1] > -2));
