var x{1..5} integer >= 0 <= 4;
maximize o: (0)*x[1] + (6)*x[2] + (0)*x[3] + (5)*x[4] + (6)*x[5];
s.t. c1: abs(x[3] - x[2]) < 4;
s.t. c2: ((x[4] >= 3) ==> (x[3] != 4)) and ((x[3] != 4) ==> (x[4] >= 3));
s.t. c3: abs(x[3] - x[2]) < 4;
s.t. c4: ((x[4] >= 3) ==> (x[3] != 4)) and ((x[3] != 4) ==> (x[4] >= 3));
