var x{1..6} integer >= 0 <= 4;

maximize o: 6*x[1] + 3*x[2] + 4*x[3] - 3*x[4] + 3*x[5] + 0*x[6];

s.t. c1: ((x[1] != 4) ==> (x[1] >= 4)) and ((x[1] >= 4) ==> (x[6] >= 4));
s.t. c2: ((x[6] <= 0) ==> (x[2] != 1)) and ((x[2] != 1) ==> (x[3] >= 0));
s.t. c3: ((if x[2] >= 4 then 1 else 0) + (if x[1] >= 4 then 1 else 0)) >= 1;
