var x{1..4} integer >= -2 <= 2;
minimize o: (-5)*x[1] + (4)*x[2] + (2)*x[3] + (6)*x[4];
s.t. c1: (x[1] == -1) <==> (x[4] + x[2] >= -2);
s.t. c2: (if x[4] > -1 then x[2] else x[1]) <= 2;
s.t. c3: max(x[3], x[4]) - min(x[3], x[4]) >= 0;
s.t. c4: (x[4] != 1) <==> (x[2] + x[2] == 2);
s.t. c5: x[3] == 2;
s.t. c6: x[4] == 2;
