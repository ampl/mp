var x{1..4} integer >= 0 <= 3;
minimize o: (6)*x[1] + (4)*x[2] + (1)*x[3] + (0)*x[4];
s.t. c1: ((x[4] != 2) ==> (x[3] == 1)) and ((x[3] == 1) ==> (x[2] >= 2));
s.t. c2: (x[2] != 0) ==> (x[2] < 1);
s.t. c3: (x[2] <= 0) or (x[2] < 1) or (x[2] == 1);
s.t. c4: (x[3] > 0) <==> (x[2] + x[3] == 1);
s.t. c5: (x[2] < 3) ==> (x[2] <= 2) else (x[4] > 3);
s.t. c6: not ((x[4] == 1) and (x[2] == 3));
