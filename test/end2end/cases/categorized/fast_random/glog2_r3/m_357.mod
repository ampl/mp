var x{1..5} integer >= 0 <= 4;
maximize o: (-666)*x[1] + (-333)*x[2] + (-1000)*x[3] + (-666)*x[4] + (-666)*x[5];
s.t. c1: (x[2] >= 3) <==> (x[4] + x[5] == 0);
s.t. c2: (x[3] != 3) ==> (x[5] <= 1);
s.t. c3: (x[5] < 4) ==> (x[5] < 4) else (x[2] > 2);
s.t. c4: (x[3] <= 3) and (x[1] != 3) ==> (x[2] >= 3);
