var x{1..6} integer >= -2 <= 0;
maximize o: (0)*x[1] + (-1)*x[2] + (-1)*x[3] + (4)*x[4] + (4)*x[5] + (-3)*x[6];
s.t. c1: exists {i in 1..6} x[i] == -2;
s.t. c2: ((x[1] >= -2) ==> (x[5] == -1)) and ((x[5] == -1) ==> (x[5] >= -2));
s.t. c3: (if x[6] != -2 then x[1] else x[1]) < -2;
s.t. c4: (x[3] < -1) and (x[3] == -2) ==> (x[5] >= -1);
