var x{1..5} integer >= 0 <= 4;

maximize o: -4*x[1] + 6*x[2] - 4*x[3] + 6*x[4] - x[5];

s.t. c1: (x[1] == 3) <==> (x[2] + x[2] > 2);
s.t. c2: ((x[1] < 4) ==> (x[4] < 0)) and ((x[4] < 0) ==> (x[2] >= 4));
s.t. c3: (if x[4] >= 1 then x[1] else x[4]) == 4;
s.t. c4: (x[1] < 1) and (x[2] < 2) ==> (x[1] >= 1);
s.t. c5: (x[1] == 3) <==> (x[2] + x[2] > 2);
s.t. c6: (x[1] < 1) and (x[2] < 2) ==> (x[1] >= 1);
