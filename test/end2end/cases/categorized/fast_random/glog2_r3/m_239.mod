var x{1..4} integer >= 0 <= 3;
minimize o: (-1)*x[1] + (0)*x[2] + (3)*x[3] + (3)*x[4];
s.t. c1: (x[3] >= 1) and (x[3] > 1) ==> (x[1] >= 1);
s.t. c2: (x[2] != 0) ==> (x[1] == 2) else (x[4] < 3);
s.t. c3: max(x[2], x[4]) - min(x[2], x[2]) > 1;
s.t. c4: (x[3] >= 1) and (x[3] > 1) ==> (x[1] >= 1);
s.t. c5: max(x[2], x[4]) - min(x[2], x[2]) > 1;
