var x{1..6} integer >= -2 <= 0;

maximize o: -2*x[1] + 5*x[2] - 3*x[3] - 2*x[4] - 3*x[5] + 2*x[6];

s.t. c1: (x[2] <= -1) and (x[6] < 0) ==> (x[3] >= -1);
s.t. c2: max(x[3], x[4]) - min(x[6], x[6]) <= 0;
s.t. c3: abs(x[4] - x[5]) == 0;
s.t. c4: (x[1] == -2) <==> (x[3] + x[2] == 0);
s.t. c5: not ((x[6] <= -1) and (x[6] != -1));
s.t. c6: max(x[6], x[2]) - min(x[1], x[3]) >= -2;
s.t. c7: ((x[1] != -1) ==> (x[2] == -2)) and ((x[2] == -2) ==> (x[2] >= -1));
