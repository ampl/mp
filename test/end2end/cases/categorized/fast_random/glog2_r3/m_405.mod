var x{1..5} integer >= 0 <= 2;

maximize o: x[1] + 3*x[2] - 5*x[3] + 5*x[4] - 3*x[5];

s.t. c1: (x[4] <= 0) ==> (x[1] == 1) else (x[3] == 2);
s.t. c2: (x[2] > 2) ==> (x[2] <= 2);
s.t. c3: (x[3] < 2) ==> (x[2] >= 1) else (x[1] == 1);
s.t. c4: (x[5] == 0) or (x[5] <= 1) or (x[2] >= 1);
s.t. c5: (x[2] > 2) <==> (x[2] + x[1] >= 1);
s.t. c6: not ((x[1] < 2) and (x[2] != 1));
s.t. c7: (x[4] == 2) or (x[2] <= 2) or (x[2] <= 2);
