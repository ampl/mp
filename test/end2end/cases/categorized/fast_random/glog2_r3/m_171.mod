var x{1..5} integer >= 0 <= 4;
minimize o: (1)*x[1] + (-5)*x[2] + (5)*x[3] + (1)*x[4] + (5)*x[5];
s.t. c1: (x[4] < 0) ==> (x[5] != 5);
s.t. c2: ((if x[3] > 0 then 1 else 0) + (if x[3] >= 0 then 1 else 0)) >= 1;
s.t. c3: ((x[1] == 0) ==> (x[1] > -1)) and ((x[1] > -1) ==> (x[2] >= 0));
s.t. c4: (x[1] >= 0) and (x[5] > -1) ==> (x[1] >= 0);
