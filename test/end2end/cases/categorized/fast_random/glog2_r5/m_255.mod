var x{1..4} integer >= 0 <= 4;
minimize o: (6)*x[1] + (-4)*x[2] + (4)*x[3] + (-2)*x[4];
s.t. c1: (x[4] == 4) <==> (x[2] + x[1] < 2);
s.t. c2: alldiff(x[2], x[1]);
s.t. c3: (if x[1] >= 2 then x[1] else x[4]) > 1;
s.t. c4: abs(x[2] - x[2]) <= 3;
s.t. c5: ((x[2] != 2) ==> (x[4] == 1)) and ((x[4] == 1) ==> (x[1] >= 2));
s.t. c6: ((x[2] < 1) ==> (x[4] <= 3)) and ((x[4] <= 3) ==> (x[1] >= 1));
