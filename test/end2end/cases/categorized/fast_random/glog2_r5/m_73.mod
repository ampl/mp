var x{1..6} integer >= 0 <= 2;
maximize o: (4)*x[1] + (-2)*x[2] + (-1)*x[3] + (-1)*x[4] + (-3)*x[5] + (5)*x[6];
s.t. c1: abs(x[6] - x[2]) == 2;
s.t. c2: (x[5] == 2) <==> (x[1] + x[6] >= 2);
s.t. c3: (x[6] > 0) or (x[4] < 1) or (x[4] <= 0);
s.t. c4: (x[5] < 1) ==> (x[2] < 1) else (x[5] > 0);
s.t. c5: x[5] == 2;
s.t. c6: x[3] == 0;
