var x{1..5} integer >= -2 <= 1;
maximize o: (0)*x[1] + (0)*x[2] + (0)*x[3] + (0)*x[4] + (0)*x[5];
s.t. c1: abs(x[2] - x[5]) >= 2;
s.t. c2: forall {i in 1..4} x[i] != x[i+1];
s.t. c3: (x[3] >= -2) ==> (x[3] != 0) else (x[3] >= 0);
s.t. c4: ((x[4] != -2) ==> (x[1] == -1)) and ((x[1] == -1) ==> (x[2] >= -2));
