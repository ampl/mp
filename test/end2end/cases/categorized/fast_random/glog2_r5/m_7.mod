var x{1..6} integer >= -2 <= 1;

maximize o: -1000*x[1] + 51*x[2] - 2000*x[3] + 17*x[4] - 3000*x[5] + 34*x[6];

s.t. c1: (x[3] == -2) ==> (x[6] <= 1) else (x[2] < 1);
s.t. c2: (x[5] != -1) ==> (x[5] != -1) else (x[6] <= -2);
s.t. c3: (x[4] <= -1) ==> (x[3] <= -2) else (x[6] != 0);
s.t. c4: (x[3] != 0) <==> (x[3] + x[2] > -1);
