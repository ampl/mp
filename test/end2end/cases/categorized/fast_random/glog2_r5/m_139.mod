var x{1..6} integer >= 0 <= 4;
maximize o: (-2)*x[1] + (-1)*x[2] + (-3)*x[3] + (0)*x[4] + (2)*x[5] + (3)*x[6];
s.t. c1: (x[4] <= 3) <==> (x[5] + x[5] < 2);
s.t. c2: alldiff(x[1], x[5], x[6]);
s.t. c3: (x[2] == 0) ==> (x[5] != 0) else (x[3] == 0);
s.t. c4: (x[4] <= 3) <==> (x[5] + x[5] < 2);
s.t. c5: (x[2] == 0) ==> (x[5] != 0) else (x[3] == 0);
