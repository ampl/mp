var x{1..6} integer >= 0 <= 4;
minimize o: (-666)*x[1] + (1000)*x[2] + (-2000)*x[3] + (-1000)*x[4] + (-1000)*x[5] + (17)*x[6];
s.t. c1: (if x[5] > 2 then x[3] else x[1]) >= 1;
s.t. c2: max(x[2], x[5]) - min(x[1], x[1]) > 4;
s.t. c3: (x[6] == 4) ==> (x[6] <= 0);
s.t. c4: (x[3] != 1) and (x[2] >= 1) ==> (x[4] >= 1);
