var x{1..5} integer >= -2 <= 3;

minimize o: 4*x[1] + 5*x[2] - 4*x[3] + 4*x[4] - 4*x[5];

s.t. c1: ((x[3] > 2) ==> (x[5] <= -1)) and ((x[5] <= -1) ==> (x[5] >= 2));
s.t. c2: (x[3] == 3) or (x[2] >= 0) or (x[4] <= 3);
s.t. c3: max(x[1], x[3]) - min(x[2], x[2]) <= -2;
s.t. c4: (x[3] <= 3) ==> (x[3] > 2);
