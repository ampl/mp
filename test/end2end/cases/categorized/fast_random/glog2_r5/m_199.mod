var x{1..5} integer >= 0 <= 2;

maximize o: 4*x[1] + x[2] + 4*x[3] - 2*x[4] - 5*x[5];

s.t. c1: atleast 3 {i in 1..5} (x[i] >= 0);
s.t. c2: max(x[2], x[2]) - min(x[4], x[2]) <= 1;
s.t. c3: (x[5] == 1) or (x[2] != 1) or (x[3] == 1);
s.t. c4: ((x[5] != 1) ==> (x[5] <= 2)) and ((x[5] <= 2) ==> (x[4] >= 1));
s.t. c5: atleast 3 {i in 1..5} (x[i] >= 0);
s.t. c6: ((x[5] != 1) ==> (x[5] <= 2)) and ((x[5] <= 2) ==> (x[4] >= 1));
