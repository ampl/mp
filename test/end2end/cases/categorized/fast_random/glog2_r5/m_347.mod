var x{1..6} integer >= 0 <= 4;

maximize o: 2000*x[1] + 3000*x[2] + 51*x[3] - 333*x[4] - 333*x[5] - 999*x[6];

s.t. c1: ((if x[1] > 4 then 1 else 0) + (if x[1] >= 4 then 1 else 0)) >= 1;
s.t. c2: (x[4] == 2) <==> (x[5] + x[6] > 3);
s.t. c3: (x[6] == 1) <==> (x[5] + x[6] <= 4);
s.t. c4: (x[3] >= 0) and (x[4] < 2) ==> (x[3] >= 0);
