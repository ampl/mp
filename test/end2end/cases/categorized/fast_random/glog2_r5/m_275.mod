var x{1..3} integer >= -2 <= 1;

maximize o: -4*x[1] + 6*x[2] + 4*x[3];

s.t. c1: (x[3] > 0) ==> (x[1] < -2);
s.t. c2: atleast 2 {i in 1..3} (x[i] >= -2);
s.t. c3: alldiff(x[2], x[1]);
s.t. c4: (x[3] >= -1) and (x[3] < -1) ==> (x[1] >= -1);
s.t. c5: (x[3] != 0) ==> (x[1] <= -2) else (x[3] != 1);
s.t. c6: (x[3] <= -2) and (x[2] > 1) ==> (x[3] >= -2);
s.t. c7: (x[3] == -2) ==> (x[3] != -1) else (x[2] != -2);
