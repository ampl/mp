var x{1..4} integer >= 0 <= 4;
minimize o: (-5)*x[1] + (-4)*x[2] + (3)*x[3] + (-1)*x[4];
s.t. c1: (x[4] > 1) <==> (x[2] + x[2] >= 2);
s.t. c2: numberof 2 in (x[1], x[2], x[3], x[4]) > 3;
s.t. c3: (x[1] > 2) and (x[2] > 3) ==> (x[1] >= 2);
s.t. c4: (x[4] > 1) <==> (x[2] + x[2] >= 2);
s.t. c5: (x[1] > 2) and (x[2] > 3) ==> (x[1] >= 2);
