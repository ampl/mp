var x{1..5} integer >= 0 <= 3;
maximize o: (6)*x[1] + (-2)*x[2] + (6)*x[3] + (-1)*x[4] + (-3)*x[5];
s.t. c1: (x[2] == 1) <==> (x[5] + x[4] < 2);
s.t. c2: alldiff(x[2], x[1], x[3]);
s.t. c3: (x[3] != 0) ==> (x[3] > 3);
s.t. c4: atmost 1 {i in 1..5} (x[i] >= 0);
s.t. c5: (x[4] == 2) and (x[1] <= 2) ==> (x[5] >= 2);
