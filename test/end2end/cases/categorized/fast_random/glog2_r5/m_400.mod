var x{1..4} integer >= -2 <= 1;
maximize o: (-2)*x[1] + (-3)*x[2] + (-2)*x[3] + (4)*x[4];
s.t. c1: (x[2] > 0) and (x[3] >= -1) ==> (x[1] >= 0);
s.t. c2: (x[3] <= -2) and (x[3] == -2) ==> (x[3] >= -2);
s.t. c3: forall {i in 1..3} x[i] != x[i+1];
s.t. c4: (x[4] <= -1) ==> (x[2] <= 0) else (x[3] <= 1);
