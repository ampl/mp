var x{1..6} integer >= 0 <= 3;

minimize o: 0*x[1] + 6*x[2] - x[3] - 2*x[4] + 3*x[5] + 6*x[6];

s.t. c1: not ((x[3] <= 3) and (x[4] >= 0));
s.t. c2: max(x[2], x[3]) - min(x[3], x[3]) == 3;
s.t. c3: (x[4] < 2) <==> (x[5] + x[6] >= 0);
s.t. c4: (x[5] != 2) or (x[4] != 1) or (x[2] == 2);
s.t. c5: not ((x[3] <= 3) and (x[4] >= 0));
s.t. c6: (x[5] != 2) or (x[4] != 1) or (x[2] == 2);
