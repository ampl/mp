var x{1..3} integer >= -2 <= 2;
maximize o: (-1)*x[1] + (-1)*x[2] + (3)*x[3];
s.t. c1: not ((x[2] > 2) and (x[2] > -1));
s.t. c2: (x[3] >= 2) and (x[1] > -2) ==> (x[3] >= 2);
s.t. c3: (x[3] <= -2) or (x[1] != -1) or (x[2] >= -2);
s.t. c4: (x[1] < -1) ==> (x[3] == 0) else (x[1] <= 2);
s.t. c5: alldiff(x[1], x[3], x[2]);
s.t. c6: (x[1] != 1) ==> (x[2] == -2) else (x[3] < -2);
s.t. c7: (x[3] <= -1) ==> (x[3] == -1) else (x[3] < -2);
