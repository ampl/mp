var x{1..5} integer >= 0 <= 4;
minimize o: (5)*x[1] + (-2)*x[2] + (4)*x[3] + (-5)*x[4] + (-1)*x[5];
s.t. c1: abs(x[2] - x[4]) > 4;
s.t. c2: abs(x[5] - x[1]) != 1;
s.t. c3: (x[1] < 0) ==> (x[1] <= 4);
s.t. c4: (x[4] >= 2) ==> (x[5] < 4) else (x[1] < 2);
s.t. c5: (x[3] == 2) and (x[4] == 2) ==> (x[5] >= 2);
