var x{1..6} integer >= 0 <= 4;
maximize o: (-1)*x[1] + (3)*x[2] + (-4)*x[3] + (-4)*x[4] + (-3)*x[5] + (-4)*x[6];
s.t. c1: ((x[2] > 3) ==> (x[2] >= 2)) and ((x[2] >= 2) ==> (x[5] >= 3));
s.t. c2: (x[5] <= 4) or (x[5] != 0) or (x[5] <= 0);
s.t. c3: ((if x[2] < 1 then 1 else 0) + (if x[2] >= 1 then 1 else 0)) >= 1;
