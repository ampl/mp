var x{1..6} integer >= 0 <= 3;
minimize o: (-2)*x[1] + (3)*x[2] + (1)*x[3] + (2)*x[4] + (2)*x[5] + (4)*x[6];
s.t. c1: not ((x[1] <= 0) and (x[5] > 2));
s.t. c2: (x[3] != 2) or (x[4] < 3) or (x[1] < 0);
s.t. c3: exists {i in 1..6} x[i] == 2;
s.t. c4: ((x[3] > 2) ==> (x[6] == 2)) and ((x[6] == 2) ==> (x[4] >= 2));
