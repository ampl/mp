var x{1..5} integer >= 0 <= 4;

minimize o: -4*x[1] + 4*x[2] + 6*x[3] - 5*x[4] - 4*x[5];

s.t. c1: exists {i in 1..5} x[i] == 3;
s.t. c2: (x[2] > 3) <==> (x[1] + x[2] > 4);
s.t. c3: ((x[2] <= 2) ==> (x[1] > 3)) and ((x[1] > 3) ==> (x[1] >= 2));
s.t. c4: ((x[1] == 1) ==> (x[4] > 4)) and ((x[4] > 4) ==> (x[5] >= 1));
s.t. c5: (x[1] != 2) and (x[3] > 2) ==> (x[3] >= 2);
s.t. c6: (x[3] <= 2) and (x[5] != 1) ==> (x[1] >= 2);
