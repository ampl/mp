var x{1..6} integer >= -2 <= 1;
minimize o: (51)*x[1] + (17)*x[2] + (-3000)*x[3] + (-999)*x[4] + (2000)*x[5] + (-1000)*x[6];
s.t. c1: (x[4] <= -1) ==> (x[6] < 1) else (x[2] < -2);
s.t. c2: (x[1] > 1) <==> (x[6] + x[2] > -2);
s.t. c3: (x[3] <= -1) and (x[2] <= -2) ==> (x[3] >= -1);
s.t. c4: (x[3] != 1) and (x[5] >= -1) ==> (x[6] >= 1);
