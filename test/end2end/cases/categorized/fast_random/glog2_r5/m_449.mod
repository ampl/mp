var x{1..5} integer >= 0 <= 2;

maximize o: x[1] + x[2] + 5*x[3] - 3*x[4] - 5*x[5];

s.t. c1: ((x[2] == 0) ==> (x[1] == 2)) and ((x[1] == 2) ==> (x[3] >= 0));
s.t. c2: (x[3] != 1) and (x[3] != 0) ==> (x[1] >= 1);
s.t. c3: forall {i in 1..4} x[i] != x[i+1];
s.t. c4: (x[3] < 2) and (x[2] < 0) ==> (x[3] >= 2);
s.t. c5: ((x[2] == 0) ==> (x[1] == 2)) and ((x[1] == 2) ==> (x[3] >= 0));
s.t. c6: (x[3] < 2) and (x[2] < 0) ==> (x[3] >= 2);
