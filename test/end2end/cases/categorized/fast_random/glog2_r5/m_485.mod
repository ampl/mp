var x{1..6} integer >= 0 <= 3;
minimize o: (6)*x[1] + (-1)*x[2] + (-3)*x[3] + (3)*x[4] + (5)*x[5] + (-5)*x[6];
s.t. c1: (x[6] < 2) ==> (x[4] <= 0) else (x[2] <= 0);
s.t. c2: (x[4] > 2) <==> (x[4] + x[6] < 2);
s.t. c3: (x[2] <= 1) ==> (x[3] <= 2);
s.t. c4: (x[5] < 0) ==> (x[2] < 0);
s.t. c5: ((if x[1] != 0 then 1 else 0) + (if x[2] >= 0 then 1 else 0)) >= 1;
s.t. c6: alldiff(x[3], x[4]);
