var x{1..6} integer >= 0 <= 3;
maximize o: (1)*x[1] + (3)*x[2] + (-1)*x[3] + (-4)*x[4] + (5)*x[5] + (-4)*x[6];
s.t. c1: (x[3] == 3) or (x[3] > 4) or (x[1] < 0);
s.t. c2: (x[1] != 0) or (x[6] == 3) or (x[5] != 3);
s.t. c3: (x[4] >= 4) ==> (x[1] < 4) else (x[2] < 0);
s.t. c4: (x[1] >= 4) or (x[1] != 0) or (x[2] == -1);
