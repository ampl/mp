var x{1..6} integer >= 0 <= 3;
maximize o: (-5)*x[1] + (1)*x[2] + (5)*x[3] + (-3)*x[4] + (5)*x[5] + (5)*x[6];
s.t. c1: (x[2] < 3) ==> (x[6] <= 3) else (x[5] == 1);
s.t. c2: ((x[2] >= 3) ==> (x[1] < 2)) and ((x[1] < 2) ==> (x[6] >= 3));
s.t. c3: (x[6] < 0) <==> (x[6] + x[2] == 0);
s.t. c4: max(x[4], x[5]) - min(x[1], x[2]) > 0;
s.t. c5: x[5] == 3;
