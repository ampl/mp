var x{1..6} integer >= 0 <= 3;

minimize o: 0*x[1] + 5*x[2] - 2*x[3] + 6*x[4] - 2*x[5] - 3*x[6];

s.t. c1: (x[4] > 3) <==> (x[1] + x[1] != 0);
s.t. c2: (x[1] > 1) <==> (x[1] + x[4] > 3);
s.t. c3: not ((x[4] > 2) and (x[5] > 3));
s.t. c4: (x[2] == 1) <==> (x[3] + x[5] < 1);
s.t. c5: (x[6] > 0) and (x[4] < 1) ==> (x[1] >= 0);
s.t. c6: ((x[3] <= 1) ==> (x[2] < 0)) and ((x[2] < 0) ==> (x[1] >= 1));
