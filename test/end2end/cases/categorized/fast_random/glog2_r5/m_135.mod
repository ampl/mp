var x{1..5} integer >= -2 <= 1;
maximize o: (-2)*x[1] + (-5)*x[2] + (0)*x[3] + (6)*x[4] + (0)*x[5];
s.t. c1: exists {i in 1..5} x[i] == -1;
s.t. c2: (x[1] == -1) ==> (x[3] >= 1);
s.t. c3: (x[5] != 0) ==> (x[3] == -1) else (x[1] < 0);
s.t. c4: ((x[3] <= -1) ==> (x[1] > 1)) and ((x[1] > 1) ==> (x[2] >= -1));
s.t. c5: atmost 2 {i in 1..5} (x[i] >= -2);
s.t. c6: (x[4] > -2) ==> (x[2] == 1);
s.t. c7: exists {i in 1..5} x[i] == -2;
