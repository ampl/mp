var x{1..3} integer >= 0 <= 4;

minimize o: -4*x[1] + x[2] - 5*x[3];

s.t. c1: alldiff(x[3], x[2]);
s.t. c2: (x[1] <= 2) or (x[3] <= 1) or (x[2] != 1);
s.t. c3: ((x[1] != 1) ==> (x[3] <= 3)) and ((x[3] <= 3) ==> (x[1] >= 1));
s.t. c4: (x[1] == 1) <==> (x[3] + x[2] == 1);
s.t. c5: (x[1] >= 3) ==> (x[3] <= 2);
s.t. c6: ((x[2] <= 3) ==> (x[1] >= 0)) and ((x[1] >= 0) ==> (x[1] >= 3));
