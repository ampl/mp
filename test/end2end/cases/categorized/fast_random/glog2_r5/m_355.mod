var x{1..5} integer >= -2 <= 0;
maximize o: (-2)*x[1] + (5)*x[2] + (-2)*x[3] + (0)*x[4] + (-1)*x[5];
s.t. c1: (x[1] <= 0) or (x[1] > -1) or (x[3] <= 0);
s.t. c2: (x[4] < -2) or (x[5] < -1) or (x[4] <= -1);
s.t. c3: (if x[3] == -2 then x[5] else x[2]) == -2;
s.t. c4: (x[4] >= -1) and (x[5] < 0) ==> (x[2] >= -1);
s.t. c5: max(x[3], x[4]) - min(x[5], x[1]) < -2;
s.t. c6: abs(x[5] - x[3]) < 1;
