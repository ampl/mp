var x{1..6} integer >= 0 <= 3;
maximize o: (-2000)*x[1] + (1000)*x[2] + (17)*x[3] + (-666)*x[4] + (-3000)*x[5] + (2000)*x[6];
s.t. c1: (x[1] <= 1) ==> (x[5] != 0);
s.t. c2: (if x[4] > 3 then x[2] else x[6]) == 0;
s.t. c3: not ((x[2] >= 3) and (x[3] != 2));
s.t. c4: (x[6] <= 2) ==> (x[1] > 2) else (x[5] != 1);
