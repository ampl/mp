var x{1..3} integer >= 0 <= 3;

maximize o: 2*x[1] + 6*x[2] - 4*x[3];

s.t. c1: (x[2] >= 2) ==> (x[2] >= 3);
s.t. c2: abs(x[3] - x[2]) <= 2;
s.t. c3: exists {i in 1..3} x[i] == 3;
s.t. c4: (x[1] >= 1) ==> (x[3] < 0) else (x[3] == 1);
s.t. c5: (x[2] >= 2) ==> (x[2] >= 3);
s.t. c6: (x[1] >= 1) ==> (x[3] < 0) else (x[3] == 1);
