var x{1..6} integer >= -2 <= 2;
maximize o: (2)*x[1] + (-2)*x[2] + (2)*x[3] + (-4)*x[4] + (-2)*x[5] + (-3)*x[6];
s.t. c1: (x[2] > 1) or (x[3] > 1) or (x[2] < 1);
s.t. c2: abs(x[4] - x[5]) <= 3;
s.t. c3: (x[3] > 0) and (x[5] < 1) ==> (x[3] >= 0);
s.t. c4: (x[3] >= 1) and (x[3] <= -2) ==> (x[5] >= 1);
