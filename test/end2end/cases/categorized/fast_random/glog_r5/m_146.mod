var x{1..4} integer >= 0 <= 3;

minimize o: 5*x[1] - 2*x[2] - 2*x[3] + 5*x[4];

s.t. c1: ((x[2] >= 3) ==> (x[3] < 1)) and ((x[3] < 1) ==> (x[4] >= 3));
s.t. c2: ((x[3] > 1) ==> (x[4] == 3)) and ((x[4] == 3) ==> (x[2] >= 1));
s.t. c3: ((x[1] > 3) ==> (x[2] > 1)) and ((x[2] > 1) ==> (x[1] >= 3));
s.t. c4: (x[1] < 2) or (x[1] != 2) or (x[2] < 0);
