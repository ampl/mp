var x{1..4} integer >= -2 <= 1;
minimize o: (-3)*x[1] + (0)*x[2] + (-4)*x[3] + (2)*x[4];
s.t. c1: forall {i in 1..3} x[i] != x[i+1];
s.t. c2: ((x[3] >= 0) ==> (x[1] == -2)) and ((x[1] == -2) ==> (x[1] >= 0));
s.t. c3: ((x[3] == 0) ==> (x[1] > -1)) and ((x[1] > -1) ==> (x[4] >= 0));
s.t. c4: (x[4] < -2) or (x[3] < -2) or (x[2] < -1);
