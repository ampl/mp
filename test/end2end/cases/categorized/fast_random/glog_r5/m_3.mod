var x{1..5} integer >= 0 <= 2;
maximize o: (5)*x[1] + (2)*x[2] + (-3)*x[3] + (-2)*x[4] + (-3)*x[5];
s.t. c1: ((x[1] < 1) ==> (x[2] != 1)) and ((x[2] != 1) ==> (x[4] >= 1));
s.t. c2: (x[3] != 0) and (x[3] >= 2) ==> (x[1] >= 0);
s.t. c3: exists {i in 1..5} x[i] == 0;
s.t. c4: exists {i in 1..5} x[i] == 2;
